<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Roots for the embedded app tree, relative to this project in src\Launcher\. -->
    <DonutSrcDir>$(MSBuildProjectDirectory)\..</DonutSrcDir>
    <DonutRepoRoot>$(MSBuildProjectDirectory)\..\..</DonutRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.3" />
    <!-- Bundled QRCoder (MIT), committed at src\Lib: compiles QrCode.cs against it and copies
         the DLL beside the launcher so Donut.Qr.QrCode resolves it at runtime. -->
    <Reference Include="QRCoder">
      <HintPath>$(DonutSrcDir)\Lib\QRCoder.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the PowerShell class graph, workers, and XAML: everything under src\ except
         the compiled Launcher project (its .cs are already in this DLL) and build output.
         LogicalName preserves each file's path so Program.cs extracts it back to src\... . -->
    <EmbeddedResource Include="$(DonutSrcDir)\**\*.psm1;$(DonutSrcDir)\**\*.ps1;$(DonutSrcDir)\**\*.xaml"
                      Exclude="$(DonutSrcDir)\Launcher\**;$(DonutSrcDir)\**\bin\**;$(DonutSrcDir)\**\obj\**">
      <LogicalName>src/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Runtime images the presenters + splash/tray load. assets\Screenshots is docs-only. -->
    <EmbeddedResource Include="$(DonutRepoRoot)\assets\Images\**\*.*">
      <LogicalName>assets/Images/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Embedded UI fonts (Geist Mono; OFL). Extracted beside the styles so the
         ./Fonts/#Geist Mono FontFamily token resolves from the app tree. -->
    <EmbeddedResource Include="$(DonutSrcDir)\UI\Styles\Fonts\*.*">
      <LogicalName>src/UI/Styles/Fonts/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- Native tool pushed to remote shares for disk scans; not in git, so it embeds only
         when the operator has dropped it into src\Tools\ before building. -->
    <EmbeddedResource Include="$(DonutSrcDir)\Tools\wiztree64.exe"
                      Condition="Exists('$(DonutSrcDir)\Tools\wiztree64.exe')">
      <LogicalName>src/Tools/wiztree64.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

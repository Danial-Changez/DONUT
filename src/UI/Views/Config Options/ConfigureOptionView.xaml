<!-- Configure.xaml -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PanelBackground}">
    <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Grid.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,20,30,20">
            <!-- Flags -->
            <TextBlock Text="Flags"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleTextPrimary}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Vertical"
                        Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="silent"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Silent"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="allowXML"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Allow Xml"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="lockSettings"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Lock Settings"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="advancedDriverRestore"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Advanced Driver Restore"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="userConsent"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="User Consent"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="customProxy"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Custom Proxy"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="proxyAuthentication"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Proxy Authentication"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="proxyFallbackToDirectConnection"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Proxy Fallback To Direct Connection"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="scheduleAuto"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Schedule Auto"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="scheduleManual"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Schedule Manual"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="restoreDefaults"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Restore Defaults"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="forceRestart"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Force Restart"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <!-- Arcane amber warning badge, shown only while the toggle is on. -->
                    <Border Style="{DynamicResource BadgeAmber}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsChecked, ElementName=forceRestart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Warning}"
                                  Fill="{DynamicResource AccentYellow}"
                                  Width="11"
                                  Height="11"
                                  Margin="0,0,5,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource BadgeAmberText}"
                                       Text="Auto-restarts the target machine(s)" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="autoSuspendBitLocker"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Auto Suspend Bit Locker"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="defaultSourceLocation"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Default Source Location"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="installationDeferral"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Installation Deferral"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <ToggleButton x:Name="systemRestartDeferral"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="System Restart Deferral"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="updatesNotification"
                                  Style="{DynamicResource ModernToggleSwitch}" />
                    <TextBlock Text="Updates Notification"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="14"
                               Foreground="{DynamicResource BodyTextSecondary}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <!-- Dropdown / Multi-Select Options -->
            <TextBlock Text="Dropdown / Multi-Select Options"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleTextPrimary}"
                       Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,18">
                <Grid Margin="0,0,0,8"
                      x:Name="updateSeverity">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Severity Text -->
                        <RowDefinition Height="Auto" />
                        <!-- Severity -->
                    </Grid.RowDefinitions>
                    <TextBlock Text="Update Severity"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource BodyTextPrimary}"
                               Margin="0,0,0,6"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="4" />
                    <!-- Update Severity Row -->
                    <CheckBox Content="Security"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="0" />
                    <CheckBox Content="Critical"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="1" />
                    <CheckBox Content="Recommended"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="2" />
                    <CheckBox Content="Optional"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="3" />
                </Grid>
                <Grid Margin="0,0,0,8"
                      x:Name="updateType">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Type Text -->
                        <RowDefinition Height="Auto" />
                        <!-- Type -->
                    </Grid.RowDefinitions>
                    <TextBlock Text="Update Type"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource BodyTextPrimary}"
                               Margin="0,10,0,6"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="4" />
                    <!-- Update Type Row -->
                    <CheckBox Content="Bios"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="0" />
                    <CheckBox Content="Firmware"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="1" />
                    <CheckBox Content="Driver"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="2" />
                    <CheckBox Content="Application"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="3" />
                    <CheckBox Content="Others"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="4" />
                </Grid>
                <Grid Margin="0,0,0,8"
                      x:Name="updateDeviceCategory">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Device Category Text -->
                        <RowDefinition Height="Auto" />
                        <!-- Device Category -->
                    </Grid.RowDefinitions>
                    <TextBlock Text="Update Device Category"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource BodyTextPrimary}"
                               Margin="0,10,0,6"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="4" />
                    <!-- Update Device Category Row -->
                    <CheckBox Content="Audio"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="0" />
                    <CheckBox Content="Video"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="1" />
                    <CheckBox Content="Network"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="2" />
                    <CheckBox Content="Storage"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="3" />
                    <CheckBox Content="Input"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="4" />
                    <CheckBox Content="Chipset"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="5" />
                    <CheckBox Content="Others"
                              Style="{DynamicResource ModernCheckBox}"
                              Foreground="{DynamicResource BodyTextPrimary}"
                              Grid.Row="1"
                              Grid.Column="6" />
                </Grid>
                <TextBlock Text="Schedule Action"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,8,0,6" />
                <ComboBox x:Name="scheduleAction"
                          Width="200"
                          Style="{DynamicResource ModernComboBox}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,18">
                    <ComboBoxItem x:Name="NotifyAvailableUpdates"
                                  Content="Notify Available Updates" />
                    <ComboBoxItem x:Name="DownloadAndNotify"
                                  Content="Download and Notify" />
                    <ComboBoxItem x:Name="DownloadInstallAndNotify"
                                  Content="Download Install and Notify" />
                </ComboBox>
            </StackPanel>
            <!-- Text/Number Options -->
            <TextBlock Text="Text/Number Options"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleTextPrimary}"
                       Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Output Log"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource File}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="outputLog"
                             Width="304"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Catalog Location"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Catalog}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="catalogLocation"
                             Width="304"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Driver Library Location"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource DriverLibrary}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="driverLibraryLocation"
                             Width="304"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Download Location"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Location}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="downloadLocation"
                             Width="304"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Import Settings"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Import}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="importSettings"
                             Width="304"
                             Style="{DynamicResource ModernTextBox}"
                             Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Text="Export Settings"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Export}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="exportSettings"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Bios Password"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource EncryptionKey}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="biosPassword"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Secure Bios Password"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource EncryptionKey}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="secureBiosPassword"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Proxy Host"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ProxyHost}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="proxyHost"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Proxy User Name"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ProxyUserName}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="proxyUserName"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Proxy Password"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource EncryptionKey}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="proxyPassword"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Secure Proxy Password"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource EncryptionKey}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="secureProxyPassword"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Proxy Port"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ProxyPort}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="proxyPort"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Schedule Weekly"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ScheduleWeekly}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="scheduleWeekly"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Schedule Monthly"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ScheduleMonthly}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="scheduleMonthly"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Schedule Daily"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource ScheduleDaily}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="scheduleDaily"
                             Width="320"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Deferral Install Interval"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Interval}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="deferralInstallInterval"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Deferral Install Count"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Count}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="deferralInstallCount"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Deferral Restart Interval"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Interval}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="deferralRestartInterval"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Deferral Restart Count"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource Count}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="deferralRestartCount"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
                <TextBlock Text="Max Retry"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,10,0,6" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Path Data="{DynamicResource MaxRetry}"
                          Fill="{DynamicResource AccentYellow}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,8,8,0" />
                    <TextBox x:Name="maxRetry"
                             Width="120"
                             Style="{DynamicResource ModernTextBox}" />
                </StackPanel>
            </StackPanel>
            <!-- Throttle Limit -->
            <TextBlock Text="Throttle Limit"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleTextPrimary}"
                       Margin="0,10,0,8" />
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,6,0,0">
                <Path Data="{DynamicResource Rocket}"
                      Fill="{DynamicResource ThrottleLimit}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0" />
                <TextBox x:Name="throttleLimit"
                         Width="120"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <!-- Startup & tray -->
            <TextBlock Text="Startup &amp; tray"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleTextPrimary}"
                       Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <ToggleButton x:Name="chkStartWithWindows"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Start with Windows (as admin)"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="14"
                           Foreground="{DynamicResource BodyTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <ToggleButton x:Name="chkCloseToTray"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Close to tray (X hides instead of exits)"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="14"
                           Foreground="{DynamicResource BodyTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Global hotkey (blank to disable)"
                       FontFamily="{DynamicResource FontSans}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource BodyTextPrimary}"
                       Margin="0,10,0,6" />
            <TextBox x:Name="txtGlobalHotkey"
                     Width="200"
                     HorizontalAlignment="Left"
                     Style="{DynamicResource ModernTextBox}" />
        </StackPanel>
    </ScrollViewer>
</Grid>
<!-- General settings form: app-wide options as Arcane sub-cards. Control x:Names are
     read/written by ConfigPresenter's General-section binder (not dcu-cli args). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Startup & tray -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="STARTUP &amp; TRAY"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">
                <ToggleButton x:Name="chkStartWithWindows"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Start with Windows (as admin)"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="chkCloseToTray"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Close to tray (X hides instead of exits)"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Global hotkey -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="SHORTCUTS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <TextBlock Text="Global hotkey - shows/restores DONUT from anywhere. Hit Record, then press a combo (e.g. Ctrl+Alt+D). Clear to disable."
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <!-- Keybind recorder: display + Clear + Record, wired by ConfigPresenter. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8.4" Height="36" Padding="12,0"
                        VerticalAlignment="Center" Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <TextBlock x:Name="recGlobalHotkeyValue" Text="No keybind set" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontSans}" FontSize="13"
                               Foreground="{DynamicResource BodyTextPrimary}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="recGlobalHotkeyClear" Grid.Column="1" Content="Clear"
                        Style="{DynamicResource ButtonGhost}" FontSize="12" Height="36" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
                <Button x:Name="recGlobalHotkeyRecord" Grid.Column="2" Content="Record Keybind"
                        Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Height="36" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Open Settings (while DONUT is focused). Hit Record, then press a combo (e.g. Ctrl+,). Clear to disable."
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8.4" Height="36" Padding="12,0"
                        VerticalAlignment="Center" Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <TextBlock x:Name="recOpenSettingsValue" Text="No keybind set" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontSans}" FontSize="13"
                               Foreground="{DynamicResource BodyTextPrimary}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button x:Name="recOpenSettingsClear" Grid.Column="1" Content="Clear"
                        Style="{DynamicResource ButtonGhost}" FontSize="12" Height="36" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
                <Button x:Name="recOpenSettingsRecord" Grid.Column="2" Content="Record Keybind"
                        Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Height="36" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
    <!-- Tuning: throttle limit + storage-scan folder count, grouped in one card. -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="TUNING"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <TextBlock Text="Throttle limit - how many machines run concurrently on the pool."
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource Rocket}"
                      Fill="{DynamicResource ThrottleLimit}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBox x:Name="throttleLimit"
                         Width="120"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <TextBlock Text="Folders to scan - largest folders the storage scan returns."
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,8" />
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource DriverLibrary}"
                      Fill="{DynamicResource ThrottleLimit}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBox x:Name="folderScanCount"
                         Width="120"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Diagnostics: verbose logging opt-in (off by default; applies live, incl. workers). -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="DIAGNOSTICS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="chkDebugLogging"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Debug logging (verbose breadcrumbs in Donut.log)"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

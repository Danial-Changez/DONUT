<!-- General settings form: app-wide options as Arcane sub-cards. Control x:Names are
     read/written by ConfigPresenter's General-section binder (not dcu-cli args). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Startup & tray -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="STARTUP &amp; TRAY"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">
                <ToggleButton x:Name="chkStartWithWindows"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Start with Windows (as admin)"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="chkCloseToTray"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Close to tray (X hides instead of exits)"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Global hotkey -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="SHORTCUTS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <TextBlock Text="Global hotkey - shows/restores DONUT from anywhere. Blank to disable. e.g. Ctrl+Alt+D"
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBox x:Name="txtGlobalHotkey"
                     Width="200"
                     HorizontalAlignment="Left"
                     Style="{DynamicResource ModernTextBox}" />
            <TextBlock Text="Open Settings (while DONUT is focused). Blank to disable. e.g. Ctrl+,"
                       Style="{DynamicResource SettingsFieldLabel}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,8" />
            <TextBox x:Name="txtOpenSettingsShortcut"
                     Width="200"
                     HorizontalAlignment="Left"
                     Style="{DynamicResource ModernTextBox}" />
        </StackPanel>
    </Border>
    <!-- Throttle limit -->
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="THROTTLE LIMIT"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource Rocket}"
                      Fill="{DynamicResource ThrottleLimit}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBox x:Name="throttleLimit"
                         Width="120"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

<!-- Apply Updates option form: Arcane sub-cards. Control x:Names are the dcu-cli arg
     keys the ConfigPresenter binder reads/writes; multi-select chips keep their Content. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </StackPanel.Resources>
    <!-- Flags -->
    <Border CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            Padding="16,14"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="FLAGS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">
                <ToggleButton x:Name="silent"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Silent"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TitleTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="reboot"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Reboot"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TitleTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <!-- Warning shown only when Reboot is on (pure-XAML via the converter). -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsChecked, ElementName=reboot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Path Data="{DynamicResource Warning}"
                      Fill="{DynamicResource AccentYellow}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      VerticalAlignment="Top"
                      Margin="0,2,0,0" />
                <TextBlock Text="This restarts the target machine(s) automatically."
                           Foreground="{DynamicResource AccentYellow}"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0">
                <ToggleButton x:Name="autoSuspendBitLocker"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Auto Suspend BitLocker"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TitleTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0">
                <ToggleButton x:Name="forceupdate"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Force Update"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TitleTextSecondary}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Update options (multi-select chips) -->
    <Border CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            Padding="16,14"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="UPDATE OPTIONS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Severity"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateSeverity">
                    <CheckBox Content="Security" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Critical" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Recommended" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Optional" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Type"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateType">
                    <CheckBox Content="Bios" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Firmware" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Driver" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Application" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Others" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Device Category"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateDeviceCategory">
                    <CheckBox Content="Audio" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Video" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Network" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Storage" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Input" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Chipset" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Others" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Text options -->
    <Border CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            Padding="16,14"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="TEXT OPTIONS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Output Log"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="outputLog"
                         Style="{DynamicResource ModernTextBox}"
                         Foreground="{DynamicResource BodyTextPrimary}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Catalog Location"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="catalogLocation"
                         Style="{DynamicResource ModernTextBox}"
                         Foreground="{DynamicResource BodyTextPrimary}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Encrypted Password"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="encryptedPassword"
                         Style="{DynamicResource ModernTextBox}"
                         Foreground="{DynamicResource BodyTextPrimary}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Encrypted Password File"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="encryptedPasswordFile"
                         Style="{DynamicResource ModernTextBox}"
                         Foreground="{DynamicResource BodyTextPrimary}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Encryption Key"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12.5"
                           Foreground="{DynamicResource BodyTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="encryptionKey"
                         Style="{DynamicResource ModernTextBox}"
                         Foreground="{DynamicResource BodyTextPrimary}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Throttle limit -->
    <Border CornerRadius="10"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            Padding="16,14">
        <StackPanel>
            <TextBlock Text="THROTTLE LIMIT"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource Rocket}"
                      Fill="{DynamicResource ThrottleLimit}"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBox x:Name="throttleLimit"
                         Width="120"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

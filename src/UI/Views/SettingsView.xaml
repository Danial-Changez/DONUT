<!-- Config form body, hosted in the settings overlay card. The page switcher lives in the
     overlay's header row (MainWindow.xaml) so it survives scrolling; this is only the form.
     SettingsContent is looked up by name; edits persist live (no Save button). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentControl x:Name="SettingsContent" />
</StackPanel>

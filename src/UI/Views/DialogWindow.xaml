<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource PrimaryBackground}"
        AllowsTransparency="False"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- The stock template paints the scrollbar corner a SystemColors white. Scoped
             to this window so it cannot reach TextBox content hosts elsewhere. -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0"
                                                    Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                            <!-- The corner cell stays empty so no white box is drawn. -->
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="0"
            BorderThickness="1"
            BorderBrush="{DynamicResource PanelBorder}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0.75">
                <GradientStop Color="{DynamicResource PrimaryBackgroundDarkColor}"
                              Offset="0" />
                <GradientStop Color="{DynamicResource PrimaryBackgroundColor}"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Popup chrome contract: the 48px header doubles as the drag region.
                 DialogPresenter wires both the X and Esc to the same close. -->
            <Grid x:Name="panelControlBar" Grid.Row="0" Background="Transparent" Height="48">
                <TextBlock Text="{Binding Title}"
                           Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}"
                           Style="{DynamicResource TextPaneTitle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="24,0,56,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <Button x:Name="btnClose"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Height="36"
                        Style="{DynamicResource controlButton}"
                        Tag="{DynamicResource Destructive}"
                        ToolTip="Close">
                    <Path Style="{DynamicResource controlButtonIcon}"
                          Data="{DynamicResource xMark}" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"
                       Style="{DynamicResource TextBody}"
                       Margin="24,6,24,0"
                       TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="2"
                          Visibility="{Binding HasList, Converter={StaticResource BoolToVis}}"
                          MaxHeight="168" VerticalScrollBarVisibility="Auto"
                          Margin="24,12,24,0">
                <ItemsControl ItemsSource="{Binding ListItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Left}"
                                               Foreground="{DynamicResource BodyTextPrimary}"
                                               FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Right}"
                                               Foreground="{DynamicResource BodyTextSecondary}"
                                               FontFamily="{DynamicResource FontMono}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- A labelled fact wears the Card recipe, like the Lens tiles. The release
                 link rides the value row so the card stays one fact, not two. -->
            <Border Grid.Row="3"
                    Style="{DynamicResource Card}"
                    Padding="16,14"
                    Margin="24,14,24,0"
                    Visibility="{Binding HasVersionCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="VERSION"
                               Style="{DynamicResource MicroLabel}" />
                    <Grid Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionFrom}"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="15"
                                       Foreground="{DynamicResource BodyTextSecondary}" />
                            <TextBlock Text="&#x2192;"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="15"
                                       Foreground="{DynamicResource BodyTextPrimary}"
                                       Margin="7,0,7,0" />
                            <TextBlock Text="{Binding VersionTo}"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TitleTextPrimary}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="12.5"
                                   Visibility="{Binding HasReleaseUrl, Converter={StaticResource BoolToVis}}">
                            <Hyperlink x:Name="linkRelease"
                                       NavigateUri="{Binding ReleaseUrl}"
                                       Foreground="{DynamicResource AccentPurpleLight}"
                                       TextDecorations="None">
                                <TextBlock Text="{Binding ReleaseLinkText}" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Its own row at the content gutter, never the footer: footers hold decisions,
                 and this modifies the decision the footer commits. -->
            <CheckBox Grid.Row="4"
                      Style="{DynamicResource ModernCheckBox}"
                      Content="{Binding RememberText}"
                      IsChecked="{Binding Remember, Mode=TwoWay}"
                      Visibility="{Binding HasRemember, Converter={StaticResource BoolToVis}}"
                      Margin="24,16,24,0" />

            <!-- The VM picks the primary Style, tinting it destructive for irreversible acts. -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,22,24,20">
                <Button Content="{Binding SecondaryText}"
                        Command="{Binding SecondaryCommand}"
                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}"
                        MinWidth="96" Height="36" Margin="0,0,8,0"
                        Style="{DynamicResource ButtonSecondary}" />
                <Button Content="{Binding PrimaryText}"
                        Command="{Binding PrimaryCommand}"
                        MinWidth="96" Height="36"
                        Style="{Binding PrimaryStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
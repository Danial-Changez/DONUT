<?xml version="1.0" encoding="UTF-8"?>
<!-- The Home page shell, a pure slot frame. Each region lives in its own file under
     Home/ with its own namescope, loaded by HomePresenter.ComposeRegions. -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <!-- Action bar -->
    <RowDefinition Height="Auto" />
    <!-- Overview strip -->
    <RowDefinition Height="*" />
    <!-- Machine list + detail -->
  </Grid.RowDefinitions>

  <!-- ====== Action bar: Home/ActionBar.xaml, whose ElementName refs stay in-file ====== -->
  <ContentControl x:Name="slotActionBar" Grid.Row="0" Focusable="False" IsTabStop="False" />

  <!-- == Overview strip: Home/StatCards.xaml, whose root carries the Person collapse == -->
  <ContentControl x:Name="slotStatCards" Grid.Row="1" Focusable="False" IsTabStop="False" />

  <!-- ==================== Machine list (left) + detail pane (right) ==================== -->
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
      <!-- Clamped so a wide window gives the extra space to the detail pane. The floor
           is what a card needs to show a hostname beside its chip and buttons. -->
      <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="460" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="3*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- ========== Machine list: composed from Home/MachinePane.xaml ========== -->
    <ContentControl x:Name="slotMachinePane" Grid.Column="0" Focusable="False" IsTabStop="False" />

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

    <!-- ============ Detail pane: composed from Home/DetailPane.xaml ============ -->
    <ContentControl x:Name="slotDetailArea" Grid.Column="2" Focusable="False" IsTabStop="False" />
  </Grid>
</Grid>

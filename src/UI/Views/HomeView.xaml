<?xml version="1.0" encoding="UTF-8"?>
<!-- HomeView.xaml - the Home page SHELL. Pure slot frame: each region lives in its own
     file under Home/ (its own namescope), loaded by HomePresenter.ComposeRegions. -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <!-- Action bar -->
    <RowDefinition Height="Auto" />
    <!-- Overview strip -->
    <RowDefinition Height="*" />
    <!-- Machine list + detail -->
  </Grid.RowDefinitions>

  <!-- ====== Action bar: composed from Home/ActionBar.xaml (search + finder popup,
       mode pill, Run all - the popup's ElementName refs stay inside that file). ====== -->
  <ContentControl x:Name="slotActionBar" Grid.Row="0" Focusable="False" IsTabStop="False" />

  <!-- == Overview strip: composed from Home/StatCards.xaml (pure SelectedMachine
       bindings; its Person-mode collapse trigger travels on the region root). == -->
  <ContentControl x:Name="slotStatCards" Grid.Row="1" Focusable="False" IsTabStop="False" />

  <!-- ==================== Machine list (left) + detail pane (right) ==================== -->
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
      <!-- Machine list is clamped (MaxWidth): wide enough for a full 15-char name + status chip
           + Run, while a wide/full-screen window still gives the detail pane the extra space. -->
      <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="460" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="3*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- ========== Machine list: composed from Home/MachinePane.xaml ========== -->
    <ContentControl x:Name="slotMachinePane" Grid.Column="0" Focusable="False" IsTabStop="False" />

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

    <!-- ============ Detail pane: composed from Home/DetailPane.xaml ============ -->
    <ContentControl x:Name="slotDetailArea" Grid.Column="2" Focusable="False" IsTabStop="False" />
  </Grid>
</Grid>

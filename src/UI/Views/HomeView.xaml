<?xml version="1.0" encoding="UTF-8"?>
<!-- HomeView.xaml -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <!-- Action bar -->
    <RowDefinition Height="Auto" />
    <!-- Overview strip -->
    <RowDefinition Height="*" />
    <!-- Machine list -->
  </Grid.RowDefinitions>

  <Grid.Resources>
    <!-- Converter + machine-list item chrome. The machine list binds to
         HomeViewModel.Machines; each item is a HostViewModel. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="MachineListItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <!-- Strip the default ListBoxItem selection chrome; the row template draws its own
           selected border via the IsSelected trigger. -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- ============================ Action bar ============================ -->
  <Grid Grid.Row="0" Margin="0,0,0,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Add / run input: type or paste WSIDs (comma- or space-separated), Enter to add.
         One Arcane input surface - the bar carries the fill + focus ring; the icon and
         the transparent single-line field sit on it. Down/Up drive the finder dropdown. -->
    <Border
      x:Name="SearchBox"
      Grid.Column="0"
      BorderThickness="1"
      CornerRadius="8.4"
      Padding="12,0"
      Height="40"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource InputFill}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
              <Setter Property="Background" Value="{DynamicResource InputBorder}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path
          Data="{DynamicResource Search}"
          Height="16"
          Width="16"
          Stretch="Uniform"
          Fill="{DynamicResource BodyTextPrimary}"
          VerticalAlignment="Center"
          Grid.Column="0"
        />
        <TextBox
          x:Name="GoogleSearchBar"
          Style="{DynamicResource GoogleSearchBar}"
          Grid.Column="1"
          Margin="2,0,0,0"
          AcceptsReturn="False"
          TextWrapping="NoWrap"
          HorizontalScrollBarVisibility="Hidden"
          VerticalScrollBarVisibility="Disabled"
          VerticalContentAlignment="Center"
          FontWeight="SemiBold"
        />
      </Grid>
    </Border>

    <!-- Live AD finder dropdown: computers (type-ahead for scan/run) + users (UPN, unlock when locked) -->
    <Popup x:Name="SearchResultsPopup"
           Grid.Column="0"
           PlacementTarget="{Binding ElementName=SearchBox}"
           Placement="Bottom"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=SearchBox}">
      <Border Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="10"
              Margin="0,4,0,0"
              Padding="6"
              SnapsToDevicePixels="True">
        <!-- One flat list of SearchRowViewModels: section headers and result rows share
             the template, switched by IsHeader. A ListBox (not ItemsControl) so Down/Up
             from the search bar can drive SelectedIndex; selection highlights the row. -->
        <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}"
                 Background="Transparent" BorderThickness="0" MaxHeight="340"
                 ItemContainerStyle="{StaticResource MachineListItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <!-- Section header ("COMPUTERS" / "USERS") -->
                  <TextBlock Text="{Binding HeaderText}" FontFamily="{DynamicResource FontSans}" FontSize="10"
                             FontWeight="SemiBold" Foreground="{DynamicResource BodyTextTertiary}"
                             Margin="6,6,0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <!-- Result row: click or Enter picks (computers fill the bar, users open
                       the Lens); keyboard highlight mirrors hover. -->
                  <Border CornerRadius="7" Padding="10,6,8,6" Margin="0,0,0,2">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <!-- Add row shown but the text isn't a machine name: dim, still pickable. -->
                          <DataTrigger Binding="{Binding Dim}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                          </Trigger>
                          <!-- Keyboard-selected row = what Enter will do; violet so it reads at a glance. -->
                          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.InputBindings>
                      <!-- Null for user rows: the gesture is simply ignored. -->
                      <MouseBinding MouseAction="LeftClick" Command="{Binding PickCommand}" />
                    </Border.InputBindings>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <!-- "+" badge for the Add-as-a-machine action row only -->
                      <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0"
                              VerticalAlignment="Center" Background="{DynamicResource PanelBackgroundActive}"
                              Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="+" FontFamily="{DynamicResource FontSans}" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPurpleLight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Primary}" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                   Foreground="{DynamicResource TitleTextPrimary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Primary}" />
                        <TextBlock Text="{Binding Secondary}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                                   Foreground="{DynamicResource BodyTextTertiary}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}" />
                      </StackPanel>
                      <!-- The row's one action earns the tint (colour hierarchy); Outline is
                           reserved for low-emphasis navigation (tour Back). -->
                      <Button Grid.Column="2" Content="Unlock" Command="{Binding UnlockCommand}"
                              Style="{DynamicResource ButtonTintPrimary}" Height="32" FontSize="11"
                              VerticalAlignment="Center"
                              ToolTip="Unlock this locked-out account"
                              Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>

    <!-- Quick mode cycle: click to switch the active command, using its defaults -->
    <Button
      x:Name="btnMode"
      Grid.Column="1"
      VerticalAlignment="Center"
      Width="100"
      Height="32"
      Margin="12,0,0,0"
      Style="{DynamicResource ButtonPill}"
      ToolTip="Click to cycle the active command (Scan / Apply) using its defaults"
    >
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="&#x27F3;" FontFamily="{DynamicResource FontSymbol}" FontSize="13"
                   Foreground="{DynamicResource BodyTextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
        <TextBlock x:Name="txtMode" Text="Scan" FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TitleTextPrimary}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Run all idle machines using the active mode (Scan / Apply Updates) -->
    <Button
      x:Name="btnRunAll"
      Grid.Column="2"
      Content="Run all"
      Style="{DynamicResource ButtonTintSuccess}"
      Width="100"
      Height="32"
      Margin="12,0,0,0"
    />
  </Grid>

  <!-- ============= Overview strip: mirrors the SELECTED remote machine ============= -->
  <!-- Machine-only: collapse it while the Lens (a user) is shown in the detail pane. -->
  <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding DetailMode}" Value="Person">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Machine (model + service tag) -->
    <Border Grid.Column="0" Margin="0,0,6,0" Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="MACHINE" Style="{DynamicResource MicroLabel}" />
        <TextBlock Text="{Binding SelectedMachine.OvModel, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvModel}"
                   Style="{DynamicResource StatValue}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvModelSub, FallbackValue='no machine selected'}"
                 ToolTip="{Binding SelectedMachine.OvModelSub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- Battery health -->
    <Border Grid.Column="1" Margin="6,0,6,0" Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="BATTERY HEALTH" Style="{DynamicResource MicroLabel}" />
        <TextBlock Text="{Binding SelectedMachine.OvBattery, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvBattery}"
                   Style="{DynamicResource StatValue}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvBatterySub}"
                 ToolTip="{Binding SelectedMachine.OvBatterySub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- Disk free -->
    <Border Grid.Column="2" Margin="6,0,6,0" Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="DISK" Style="{DynamicResource MicroLabel}" />
        <TextBlock Text="{Binding SelectedMachine.OvDisk, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvDisk}"
                   Style="{DynamicResource StatValue}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvDiskSub}"
                 ToolTip="{Binding SelectedMachine.OvDiskSub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- BIOS / firmware version (the update count already lives on the machine card + the
         Available Updates card, so this slot shows a fact that isn't surfaced elsewhere). -->
    <Border Grid.Column="3" Margin="6,0,0,0" Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="BIOS" Style="{DynamicResource MicroLabel}" />
        <TextBlock Text="{Binding SelectedMachine.OvBios, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvBios}"
                   Style="{DynamicResource StatValue}" />
      </StackPanel>
    </Border>
  </Grid>

  <!-- ==================== Machine list (left) + detail pane (right) ==================== -->
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
      <!-- Machine list is clamped (MaxWidth): wide enough for a full 15-char name + status chip
           + Run, while a wide/full-screen window still gives the detail pane the extra space. -->
      <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="460" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="3*" MinWidth="320" />
    </Grid.ColumnDefinitions>

  <!-- Machine list -->
  <Border x:Name="MachinePanel" Grid.Column="0" CornerRadius="10" Padding="2"
          Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- List header: a pane title (matching the detail pane's hostname title, 18px bold) with
           Clear (completed) as the right-aligned action, mirroring the detail pane's
           [title | buttons] row so the two panes read as a balanced pair (same top offset 14). -->
      <Grid Grid.Row="0" Margin="14,12,14,10">
        <TextBlock Text="Machines" Style="{DynamicResource TextPaneTitle}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button x:Name="btnClearTabs" Content="Clear" Style="{DynamicResource ButtonSecondary}"
                FontSize="12" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                ToolTip="Clear completed machines from the list" />
      </Grid>

      <!-- Rows (MVVM: a virtualizing ListBox bound to HomeViewModel.Machines; each item is
           a HostViewModel rendered by the DataTemplate below). The ListBox owns its own
           ScrollViewer, so it is NOT wrapped in one - that is what enables virtualization. -->
      <Grid Grid.Row="1" Margin="10,0,10,10">
        <!-- SelectedItem is NOT bound to SelectedMachine: a PS-class auto-property doesn't
             raise PropertyChanged when WPF writes it, so the SelectedMachine.* detail/overview
             bindings wouldn't track selection. The presenter drives HomeVm.SelectedMachine via
             SetSelected() (which raises) from SelectionChanged instead; the ListBox's own
             SelectedItem still owns the row highlight. -->
        <ListBox x:Name="MachineList"
                 ItemsSource="{Binding Machines}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource MachineListItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="rowBorder" Margin="0,0,0,8" CornerRadius="10"
                      Padding="14,10,8,10" HorizontalAlignment="Stretch" Cursor="Hand">
                <!-- Arcane table-row states: quiet resting row, violet-tinted hover,
                     stronger violet tint + primary edge when selected. -->
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RowSeparator}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowHover}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <!-- Double-click a row to gather fresh inventory (single click selects). -->
                <Border.InputBindings>
                  <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GatherCommand}" />
                </Border.InputBindings>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0"
                           VerticalAlignment="Center" Fill="{Binding DotBrush}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TitleTextPrimary}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource BodyTextTertiary}"
                               FontFamily="{DynamicResource FontMono}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subtitle}" />
                  </StackPanel>
                  <!-- The card reads busy from the "Scanning..." chip; the live bar sits atop
                       the detail pane's terminal (DetailProgress), not here (declutter). -->
                  <!-- Status chip = Arcane StatusBadge: rounded (not a pill), tinted
                       fill + 30% border, 400-shade text (all VM-driven). -->
                  <Border Grid.Column="2" CornerRadius="8.4" Padding="8,2" VerticalAlignment="Center"
                          Margin="16,0,8,0" Background="{Binding ChipBackground}"
                          BorderBrush="{Binding ChipBorderBrush}" BorderThickness="1"
                          Visibility="{Binding ChipVisible, Converter={StaticResource BoolToVis}}">
                    <!-- Glyph + label so status reads by shape, not colour alone. Segoe UI
                         Symbol is pinned so the symbols never fall back to tofu. -->
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding ChipForeground}"
                                 FontFamily="{DynamicResource FontSymbol}" FontWeight="SemiBold" FontSize="11"
                                 Margin="0,0,5,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StatusGlyph}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipForeground}"
                                 FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="11"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Button Grid.Column="3" Content="Run" Command="{Binding RunCommand}"
                          Style="{DynamicResource ButtonTintSuccess}" FontSize="11" Height="32"
                          Padding="14,4" VerticalAlignment="Center"
                          ToolTip="Run the active command on this machine" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Blank slate: a first-time user has no machines, so spell out how to start. -->
        <StackPanel
          x:Name="FleetEmptyHint"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          MaxWidth="520"
          Margin="24"
          IsHitTestVisible="False"
        >
          <TextBlock Text="No machines yet"
                     Foreground="{DynamicResource TitleTextSecondary}"
                     FontFamily="{DynamicResource FontSans}" FontSize="16" FontWeight="SemiBold"
                     TextAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Foreground="{DynamicResource BodyTextTertiary}"
                     FontFamily="{DynamicResource FontSans}" FontSize="13"
                     TextWrapping="Wrap" TextAlignment="Center" LineHeight="20">
            <Run Text="1.  Add machines: paste names, then Enter." />
            <LineBreak />
            <Run Text="2.  Or search a name to open its Lens." />
            <LineBreak />
            <Run Text="3.  Run (or Run all) to scan or apply updates." />
          </TextBlock>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

    <!-- ============================ Detail pane ============================ -->
    <Border x:Name="DetailPane" Grid.Column="2" CornerRadius="10" Padding="2"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <!-- Three modes, switched by HomeVm.DetailMode: Empty hint / Machine detail / user Lens. -->
      <Grid Margin="14,12,14,12">
        <!-- Empty state -->
        <TextBlock x:Name="DetailEmptyHint"
                   Text="Select a machine, or search a person to open their Lens."
                   Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Empty">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Content (shown when a machine is selected) -->
        <Grid x:Name="DetailContent">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Machine">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Cards + terminal are 1:1 (half/half) at the default window size; once the window
                 grows tall the cards row hits its MaxHeight and the terminal (still '*') takes all
                 the extra, so the terminal is favoured while the cards stretch to ~3-4 update
                 cards / a full folder list before capping. -->
            <RowDefinition Height="*" MaxHeight="400" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header: host + actions. Live job progress shows on the terminal's bar below. -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBox x:Name="txtDetailHost" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.DetailTitle}"
                       ToolTip="{Binding SelectedMachine.DetailTitle}" FontFamily="{DynamicResource FontSans}" FontSize="18"
                       FontWeight="Bold" Foreground="{DynamicResource TitleTextPrimary}" />
              <TextBox x:Name="txtDetailProbed" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.ProbedText}"
                       ToolTip="{Binding SelectedMachine.ProbedText}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                       Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
            </StackPanel>
            <!-- Neutral secondary variant (not a coloured tint): these are utility actions
                 subordinate to Run, so colour stays reserved for status + the primary action. -->
            <Button x:Name="btnFindFolders" Grid.Column="1" Content="Storage scan"
                    Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Width="124" Height="32" Margin="6,0,0,0" />
            <Button x:Name="btnDetailRefresh" Grid.Column="2" Content="Refresh info"
                    Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Width="110" Height="32" Margin="6,0,0,0" />
          </Grid>

          <!-- Row 1: available updates (left) + largest folders (right), side by side so a
               machine's pending updates and disk usage are visible together. Each card is
               populated independently (updates by a scan, folders by the Storage scan button),
               scrolls on its own, and shows a hint until it has data. -->
          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.25*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

          <!-- Available updates (populated after an apply-updates scan). Display-only; the
               apply is gated by a separate confirm dialog. -->
          <Border Grid.Column="0" CornerRadius="10" Padding="14,12"
                  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <!-- Header: label + a compact identity pill (full verdict in its tooltip), so
                   the safety signal stays glanceable without a full sentence eating a row. -->
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AVAILABLE UPDATES"
                           Style="{DynamicResource MicroLabel}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" CornerRadius="8.4" Padding="8,1" BorderThickness="1"
                        VerticalAlignment="Center"
                        ToolTip="{Binding SelectedMachine.UpdatesIdentityText}"
                        Visibility="{Binding SelectedMachine.HasUpdates, Converter={StaticResource BoolToVis}}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource TintAmber}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource TintAmberBorder}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Match">
                          <Setter Property="Background" Value="{DynamicResource TintGreen}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource TintGreenBorder}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Mismatch">
                          <Setter Property="Background" Value="{DynamicResource TintRed}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource TintRedBorder}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource FontSans}"
                             FontSize="10" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="UNVERIFIED" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentYellow}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Match">
                            <Setter Property="Text" Value="VERIFIED" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Mismatch">
                            <Setter Property="Text" Value="WRONG MACHINE" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentRed}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <!-- Hint until an update scan has populated the list. -->
              <TextBlock Grid.Row="1" VerticalAlignment="Top"
                         Text="Run a scan on this machine to list its available updates."
                         Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedMachine.HasUpdates}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <!-- Populated list, shown once a scan has landed (identity now lives in the
                   header pill, not a full-width sentence, to keep the card compact). -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding SelectedMachine.HasUpdates, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SelectedMachine.Updates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource PanelBackgroundHover}" BorderBrush="{DynamicResource PanelBorder}"
                              BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <!-- Line 1: update name + urgency badge -->
                          <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{DynamicResource FontSans}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TitleTextPrimary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding Name}" />
                            <!-- Urgency badge: Urgent=red, Recommended=sky, Optional=muted (inline
                                 so its colour varies without a BasedOn chain). -->
                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                    CornerRadius="8.4" Padding="8,0" Height="20" BorderThickness="1">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource TintSky}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource TintSkyBorder}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Urgency}" Value="Urgent">
                                      <Setter Property="Background" Value="{DynamicResource TintRed}" />
                                      <Setter Property="BorderBrush" Value="{DynamicResource TintRedBorder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Urgency}" Value="Optional">
                                      <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
                                      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Urgency}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding Urgency}" VerticalAlignment="Center"
                                         FontFamily="{DynamicResource FontSans}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentCyan}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Urgency}" Value="Urgent">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Urgency}" Value="Optional">
                                        <Setter Property="Foreground" Value="{DynamicResource BodyTextPrimary}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </Grid>
                          <!-- Line 2: category + version + NEW on the left; size pinned to the card's right edge -->
                          <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Style="{DynamicResource BadgeMuted}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource BadgeMutedText}" Text="{Binding Category}" />
                              </Border>
                              <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource FontMono}" FontSize="11"
                                         Foreground="{DynamicResource BodyTextPrimary}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}" />
                              <Border Style="{DynamicResource BadgeGreen}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{DynamicResource BadgeGreenText}" Text="NEW" />
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}" FontSize="11"
                                       Foreground="{DynamicResource BodyTextTertiary}" Margin="10,0,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Largest folders on C: (populated on demand by the "Storage scan" button) -->
          <Border Grid.Column="2" CornerRadius="10" Padding="14,12"
                  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <!-- Header: label + a destructive "Clear selected" action (shown once folders are
                   populated). Red is earned here - it permanently removes the folders' contents. -->
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LARGEST FOLDERS ON C:" Style="{DynamicResource MicroLabel}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Button Grid.Column="1" x:Name="btnDeleteFolders" Content="Clear selected"
                        Style="{DynamicResource ButtonTintDestructive}" FontSize="11" Height="26" Padding="10,0"
                        Visibility="{Binding SelectedMachine.HasFolders, Converter={StaticResource BoolToVis}}"
                        ToolTip="Permanently clear the contents of the checked folders (the folders are kept)" />
              </Grid>
              <TextBlock Grid.Row="1"
                         Text="Click &quot;Storage scan&quot; to scan this machine's C: drive."
                         Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedMachine.HasFolders}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TreeView x:Name="DiskFoldersList"
                          Style="{DynamicResource DiskTree}"
                          ItemContainerStyle="{DynamicResource DiskTreeItem}"
                          ItemsSource="{Binding SelectedMachine.Folders}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <TreeView.ItemTemplate>
                    <!-- One folder row: relative label left (root rows brighter), formatted
                         size right; children nest via the template. -->
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                      <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                          <!-- Auto, not fixed: a hidden checkbox collapses to 0 so protected rows
                               sit flush against the expander instead of reserving empty space. -->
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Clear checkbox (themed ModernCheckBox - violet when ticked): only on
                             clearable folders; two-way bound so the presenter reads the selection. -->
                        <CheckBox Grid.Column="0" Style="{DynamicResource ModernCheckBox}" Margin="0,0,6,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                  Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Select to clear this folder's contents" />
                        <TextBox Grid.Column="1" Text="{Binding Label}" ToolTip="{Binding Path}"
                                 FontFamily="{DynamicResource FontSans}" FontSize="12" VerticalAlignment="Center">
                          <TextBox.Style>
                            <!-- Selectable (mirrors SelectableText), with root rows brighter.
                                 Inlined rather than BasedOn: the codebase resolves styles via
                                 DynamicResource, and BasedOn only takes StaticResource. -->
                            <Style TargetType="TextBox">
                              <Setter Property="IsReadOnly" Value="True" />
                              <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                              <Setter Property="IsTabStop" Value="False" />
                              <Setter Property="AcceptsReturn" Value="False" />
                              <Setter Property="TextWrapping" Value="NoWrap" />
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderThickness" Value="0" />
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="Margin" Value="0" />
                              <Setter Property="Cursor" Value="IBeam" />
                              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                              <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                              <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                              <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource TitleTextPrimary}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="2" Style="{DynamicResource SelectableText}" Text="{Binding SizeText}"
                                 FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource BodyTextSecondary}"
                                 Margin="10,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </ScrollViewer>
            </Grid>
          </Border>
          </Grid>

          <!-- Live job log -->
          <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource TerminalBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ProgressBar x:Name="DetailProgress" Grid.Row="0" Height="3" Minimum="0" Maximum="100"
                           Style="{DynamicResource ThinProgressBar}"
                           Visibility="Collapsed" Background="Transparent">
                <!-- Arcane dash-meter fill: primary -> violet gradient -->
                <ProgressBar.Foreground>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource WindowBorderPrimaryColor}" Offset="1" />
                  </LinearGradientBrush>
                </ProgressBar.Foreground>
              </ProgressBar>
              <!-- Wrap + no horizontal scrollbar: the themed ScrollBar template is
                   vertical-only, so a horizontal bar renders as a stray white box. -->
              <TextBox x:Name="txtDetailLog" Grid.Row="1" IsReadOnly="True" IsTabStop="False" Background="Transparent"
                       BorderThickness="0" Foreground="{DynamicResource TerminalText}" FontFamily="{DynamicResource FontMono}"
                       FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled" Margin="6" />
            </Grid>
          </Border>
        </Grid>

        <!-- ===== User Lens: directory info + SCCM devices (shown when a user is picked) ===== -->
        <Grid x:Name="LensPanel">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Person">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <!-- Visibility (above) stays on HomeVm.DetailMode; the content binds the person VM. -->
          <Grid DataContext="{Binding SelectedPerson}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                       FontFamily="{DynamicResource FontSans}" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TitleTextPrimary}" />
              <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Upn}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                       Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" ToolTip="{Binding Upn}" />
            </StackPanel>

            <!-- Loading / error status -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource BodyTextTertiary}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentOrange}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!-- User information -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="EMAIL" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Email}" ToolTip="{Binding Email}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <TextBlock Text="MANAGER" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Manager}" ToolTip="{Binding Manager}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="SAM" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Sam}" ToolTip="{Binding Sam}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="OFFICE" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Office}" ToolTip="{Binding Office}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <!-- Devices -->
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="DEVICES" Style="{DynamicResource MicroLabel}"
                         Margin="0,0,0,8" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Name}" FontFamily="{DynamicResource FontSans}" FontSize="13.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TitleTextPrimary}" ToolTip="{Binding Name}" />
                            <TextBox Style="{DynamicResource SelectableText}" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0">
                              <TextBox.Text>
                                <MultiBinding StringFormat="{}{0}   ·   {1}">
                                  <Binding Path="Os" />
                                  <Binding Path="LastSeenText" />
                                </MultiBinding>
                              </TextBox.Text>
                            </TextBox>
                            <!-- BitLocker key: hidden until revealed (a recovery secret); selectable to copy -->
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding BitLockerText}" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                     Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap" Margin="0,6,0,0"
                                     Visibility="{Binding IsBitLockerRevealed, Converter={StaticResource BoolToVis}}" />
                            <!-- Note when there's no BitLocker / device not found -->
                            <TextBox Text="{Binding Note}" FontFamily="{DynamicResource FontSans}" FontSize="11" Foreground="{DynamicResource BodyTextTertiary}" Margin="0,4,0,0">
                              <TextBox.Style>
                                <!-- Selectable (mirrors SelectableText) + Wrap; collapses when empty. -->
                                <Style TargetType="TextBox">
                                  <Setter Property="IsReadOnly" Value="True" />
                                  <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                                  <Setter Property="IsTabStop" Value="False" />
                                  <Setter Property="AcceptsReturn" Value="False" />
                                  <Setter Property="TextWrapping" Value="Wrap" />
                                  <Setter Property="Background" Value="Transparent" />
                                  <Setter Property="BorderThickness" Value="0" />
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="Cursor" Value="IBeam" />
                                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                  <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                                  <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBox.Style>
                            </TextBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Wrapped so visibility can trigger (HasBitLocker &amp; not yet revealed)
                                 without restyling the themed button, whose style is a runtime
                                 (merged-dictionary) DynamicResource. -->
                            <ContentControl Margin="0,0,6,0">
                              <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBitLocker}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBitLockerRevealed}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ContentControl.Style>
                              <!-- Reveal/QR are neutral utilities: one tint per row (Add), so the
                                   cyan stops competing with the meaningful colour nearby. -->
                              <Button Content="Reveal key" Command="{Binding RevealCommand}"
                                      Style="{DynamicResource ButtonSecondary}" FontSize="11" Height="32"
                                      ToolTip="Reveal the latest BitLocker recovery key" />
                            </ContentControl>
                            <!-- QR of the latest recovery key: shown whenever the device has
                                 BitLocker (an alternate reveal - stays available after reveal). -->
                            <ContentControl Margin="0,0,6,0"
                                            Visibility="{Binding HasBitLocker, Converter={StaticResource BoolToVis}}">
                              <Button Content="QR" Command="{Binding ShowQrCommand}"
                                      Style="{DynamicResource ButtonSecondary}" FontSize="11" Height="32"
                                      ToolTip="Show a QR code of the latest BitLocker recovery key" />
                            </ContentControl>
                            <Button Content="Add" Command="{Binding AddCommand}"
                                    Style="{DynamicResource ButtonTintPrimary}" FontSize="11" Height="32" Padding="14,4"
                                    ToolTip="Add this machine to the list" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Empty-devices hint (only once loaded with no devices) -->
              <TextBlock Grid.Row="1" Text="No SCCM devices for this user."
                         Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasDevices}" Value="False" />
                          <Condition Binding="{Binding IsLoading}" Value="False" />
                          <Condition Binding="{Binding HasError}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Grid>

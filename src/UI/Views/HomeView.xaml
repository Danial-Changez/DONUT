<?xml version="1.0" encoding="UTF-8"?>
<!-- HomeView.xaml -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <!-- Action bar -->
    <RowDefinition Height="Auto" />
    <!-- Overview strip -->
    <RowDefinition Height="*" />
    <!-- Machine list -->
  </Grid.RowDefinitions>

  <Grid.Resources>
    <!-- Converter + machine-list item chrome. The machine list binds to
         HomeViewModel.Machines; each item is a HostViewModel. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="MachineListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <!-- Strip the default ListBoxItem selection chrome; the row template draws its own
           selected border via the IsSelected trigger. -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- ============================ Action bar ============================ -->
  <Grid Grid.Row="0" Margin="0,0,0,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Add / run input (still accepts a pasted batch of WSIDs). One Arcane input
         surface: the bar carries the fill + focus ring; the icon, the (transparent)
         TextBox, and the embedded Add sit ON it rather than as separate chrome. -->
    <Border
      x:Name="SearchBox"
      Grid.Column="0"
      BorderThickness="1"
      CornerRadius="8.4"
      Padding="12,0,5,0"
      Height="40"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource InputFill}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
              <Setter Property="Background" Value="{DynamicResource InputBorder}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path
          Data="{DynamicResource Search}"
          Height="16"
          Width="16"
          Stretch="Uniform"
          Fill="{DynamicResource BodyTextPrimary}"
          VerticalAlignment="Center"
          Grid.Column="0"
        />
        <TextBox
          x:Name="GoogleSearchBar"
          Style="{DynamicResource GoogleSearchBar}"
          Grid.Column="1"
          Margin="2,0,6,0"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          VerticalContentAlignment="Center"
          FontWeight="SemiBold"
        />
        <Button
          x:Name="btnSearch"
          Grid.Column="2"
          Content="Add"
          Style="{DynamicResource ButtonPrimary}"
          FontSize="12"
          Height="30"
          MinWidth="96"
          VerticalAlignment="Center"
        />
      </Grid>
    </Border>

    <!-- Live AD finder dropdown: computers (type-ahead for scan/run) + users (UPN, unlock when locked) -->
    <Popup x:Name="SearchResultsPopup"
           Grid.Column="0"
           PlacementTarget="{Binding ElementName=SearchBox}"
           Placement="Bottom"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=SearchBox}">
      <Border Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="10"
              Margin="0,4,0,0"
              Padding="6"
              SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
          <!-- One flat list of SearchRowViewModels: section headers and result rows share
               the template, switched by IsHeader. -->
          <ItemsControl x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <!-- Section header ("COMPUTERS" / "USERS") -->
                  <TextBlock Text="{Binding HeaderText}" FontFamily="{DynamicResource FontSans}" FontSize="10"
                             FontWeight="SemiBold" Foreground="{DynamicResource BodyTextTertiary}"
                             Margin="6,6,0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <!-- Result row: computers pick into the search bar on click; locked
                       users get an inline Unlock button. -->
                  <Border CornerRadius="7" Padding="10,6,8,6" Margin="0,0,0,2">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <!-- All result rows are clickable now: computers pick into the bar,
                             users open the Lens (both wired to PickCommand). -->
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.InputBindings>
                      <!-- Null for user rows: the gesture is simply ignored. -->
                      <MouseBinding MouseAction="LeftClick" Command="{Binding PickCommand}" />
                    </Border.InputBindings>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Primary}" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                   Foreground="{DynamicResource TitleTextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Secondary}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                                   Foreground="{DynamicResource BodyTextTertiary}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Unlock" Command="{Binding UnlockCommand}"
                              Style="{DynamicResource ButtonOutline}" Height="28" FontSize="11"
                              VerticalAlignment="Center"
                              Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Popup>

    <!-- Quick mode cycle: click to switch the active command, using its defaults -->
    <Button
      x:Name="btnMode"
      Grid.Column="1"
      VerticalAlignment="Center"
      Margin="12,0,0,0"
      Style="{DynamicResource GhostButton}"
      ToolTip="Click to cycle the active command (Scan / Apply Updates) using its defaults"
    >
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="&#x27F3;" FontFamily="Segoe UI Symbol" FontSize="13"
                   Foreground="{DynamicResource BodyTextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
        <TextBlock x:Name="txtMode" Text="Scan" FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TitleTextPrimary}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Run all idle machines using the active mode (Scan / Apply Updates) -->
    <Button
      x:Name="btnRunAll"
      Grid.Column="2"
      Content="Run all"
      Style="{DynamicResource ButtonTintSuccess}"
      Width="100"
      Height="32"
      Margin="12,0,0,0"
    />
  </Grid>

  <!-- ============= Overview strip: mirrors the SELECTED remote machine ============= -->
  <!-- Machine-only: collapse it while the Lens (a user) is shown in the detail pane. -->
  <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding DetailMode}" Value="Person">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Machine (model + service tag) -->
    <Border Grid.Column="0" Margin="0,0,6,0" CornerRadius="10" Padding="16,14"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="MACHINE" Style="{DynamicResource MicroLabel}"
                   />
        <TextBox x:Name="txtOvModel" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvModel, FallbackValue=—}" FontFamily="{DynamicResource FontSans}" FontSize="19" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" Margin="0,6,0,0" />
        <TextBox x:Name="txtOvModelSub" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvModelSub, FallbackValue='no machine selected'}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- Battery health -->
    <Border Grid.Column="1" Margin="6,0,6,0" CornerRadius="10" Padding="16,14"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="BATTERY HEALTH" Style="{DynamicResource MicroLabel}"
                   />
        <TextBox x:Name="txtOvBattery" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvBattery, FallbackValue=—}" FontFamily="{DynamicResource FontSans}" FontSize="19" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" Margin="0,6,0,0" />
        <TextBox x:Name="txtOvBatterySub" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvBatterySub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- Disk free -->
    <Border Grid.Column="2" Margin="6,0,6,0" CornerRadius="10" Padding="16,14"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="DISK" Style="{DynamicResource MicroLabel}"
                   />
        <TextBox x:Name="txtOvDisk" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvDisk, FallbackValue=—}" FontFamily="{DynamicResource FontSans}" FontSize="19" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" Margin="0,6,0,0" />
        <TextBox x:Name="txtOvDiskSub" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvDiskSub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <!-- Updates pending -->
    <Border Grid.Column="3" Margin="6,0,0,0" CornerRadius="10" Padding="16,14"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="UPDATES" Style="{DynamicResource MicroLabel}"
                   />
        <TextBox x:Name="txtOvUpdates" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvUpdates, FallbackValue=—}" FontFamily="{DynamicResource FontSans}" FontSize="19" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" Margin="0,6,0,0" />
        <TextBox x:Name="txtOvUpdatesSub" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvUpdatesSub}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
  </Grid>

  <!-- ==================== Machine list (left) + detail pane (right) ==================== -->
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="300" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="3*" MinWidth="320" />
    </Grid.ColumnDefinitions>

  <!-- Machine list -->
  <Border Grid.Column="0" CornerRadius="10" Padding="2"
          Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- List header -->
      <Grid Grid.Row="0" Margin="14,12,14,8">
        <TextBlock Text="MACHINES" Style="{DynamicResource MicroLabel}"
                   VerticalAlignment="Center" />
        <Button x:Name="btnClearTabs" Content="Clear completed" Style="{DynamicResource ButtonGhost}"
                FontSize="12.5" Width="150" Height="32" HorizontalAlignment="Right" />
      </Grid>

      <!-- Rows (MVVM: a virtualizing ListBox bound to HomeViewModel.Machines; each item is
           a HostViewModel rendered by the DataTemplate below). The ListBox owns its own
           ScrollViewer, so it is NOT wrapped in one - that is what enables virtualization. -->
      <Grid Grid.Row="1" Margin="10,0,10,10">
        <!-- SelectedItem is NOT bound to SelectedMachine: a PS-class auto-property doesn't
             raise PropertyChanged when WPF writes it, so the SelectedMachine.* detail/overview
             bindings wouldn't track selection. The presenter drives HomeVm.SelectedMachine via
             SetSelected() (which raises) from SelectionChanged instead; the ListBox's own
             SelectedItem still owns the row highlight. -->
        <ListBox x:Name="MachineList"
                 ItemsSource="{Binding Machines}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource MachineListItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="rowBorder" Margin="0,0,0,8" CornerRadius="10"
                      Padding="14,10,8,10" HorizontalAlignment="Stretch" Cursor="Hand">
                <!-- Arcane table-row states: quiet resting row, violet-tinted hover,
                     stronger violet tint + primary edge when selected. -->
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RowSeparator}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowHover}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                        <Setter Property="BorderThickness" Value="1.5" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <!-- Double-click a row to gather fresh inventory (single click selects). -->
                <Border.InputBindings>
                  <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GatherCommand}" />
                </Border.InputBindings>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0"
                           VerticalAlignment="Center" Fill="{Binding DotBrush}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TitleTextPrimary}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource BodyTextTertiary}"
                               FontFamily="{DynamicResource FontMono}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Width="120" Margin="12,0,12,0" VerticalAlignment="Center"
                              Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{DynamicResource ThinProgressBar}" Minimum="0" Maximum="100"
                                 Value="{Binding Percent}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                 Foreground="{Binding ProgressBrush}" />
                    <!-- Live milestone from dcu-cli's outputLog, e.g. "3/5 scanning devices". -->
                    <TextBlock Text="{Binding StepText}" FontFamily="{DynamicResource FontSans}" FontSize="9.5"
                               Foreground="{DynamicResource BodyTextSecondary}" Margin="0,3,0,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StepText}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <!-- Status chip = Arcane StatusBadge: rounded (not a pill), tinted
                       fill + 30% border, 400-shade text (all VM-driven). -->
                  <Border Grid.Column="3" CornerRadius="8.4" Padding="8,2" VerticalAlignment="Center"
                          Margin="0,0,8,0" Background="{Binding ChipBackground}"
                          BorderBrush="{Binding ChipBorderBrush}" BorderThickness="1"
                          Visibility="{Binding ChipVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipForeground}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="11" />
                  </Border>
                  <Button Grid.Column="4" Content="Run" Command="{Binding RunCommand}"
                          Style="{DynamicResource ButtonTintSuccess}" FontSize="11.5" Height="28"
                          Padding="14,4" VerticalAlignment="Center"
                          ToolTip="Run the active command on this machine" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock
          x:Name="FleetEmptyHint"
          Text="No machines yet. Enter computer names above and run a scan or update."
          Foreground="{DynamicResource BodyTextTertiary}"
          FontFamily="{DynamicResource FontSans}"
          FontSize="14"
          TextWrapping="Wrap"
          TextAlignment="Center"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="40"
          IsHitTestVisible="False"
        />
      </Grid>
    </Grid>
  </Border>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

    <!-- ============================ Detail pane ============================ -->
    <Border x:Name="DetailPane" Grid.Column="2" CornerRadius="10" Padding="2"
            Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
      <!-- Three modes, switched by HomeVm.DetailMode: Empty hint / Machine detail / user Lens. -->
      <Grid Margin="14,12,14,12">
        <!-- Empty state -->
        <TextBlock x:Name="DetailEmptyHint"
                   Text="Select a machine, or search a person to open their Lens."
                   Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Empty">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Content (shown when a machine is selected) -->
        <Grid x:Name="DetailContent">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Machine">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Folders + log split the remaining height equally, so a window resize
                 grows/shrinks both by the same amount. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header: host + actions -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBox x:Name="txtDetailHost" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.DetailTitle}" FontFamily="{DynamicResource FontSans}" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TitleTextPrimary}" />
              <TextBox x:Name="txtDetailProbed" Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.ProbedText}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                       Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="btnFindFolders" Grid.Column="1" Content="Storage scan"
                    Style="{DynamicResource ButtonOutline}" FontSize="12.5" Width="124" Height="32" Margin="6,0,0,0" />
            <Button x:Name="btnDetailRefresh" Grid.Column="2" Content="Refresh info"
                    Style="{DynamicResource ButtonOutline}" FontSize="12.5" Width="110" Height="32" Margin="6,0,0,0" />
          </Grid>

          <!-- Largest folders on C: (populated on demand by the "Find big folders" scan) -->
          <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="10" Padding="14,12"
                  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="LARGEST FOLDERS ON C:" Style="{DynamicResource MicroLabel}"
                         Margin="0,0,0,8" />
              <TextBlock Grid.Row="1"
                         Text="Click &quot;Storage scan&quot; to scan this machine's C: drive."
                         Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedMachine.HasFolders}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TreeView x:Name="DiskFoldersList"
                          Style="{DynamicResource DiskTree}"
                          ItemContainerStyle="{DynamicResource DiskTreeItem}"
                          ItemsSource="{Binding SelectedMachine.Folders}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <TreeView.ItemTemplate>
                    <!-- One folder row: relative label left (root rows brighter), formatted
                         size right; children nest via the template. -->
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                      <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Label}" ToolTip="{Binding Path}"
                                 FontFamily="{DynamicResource FontSans}" FontSize="12" VerticalAlignment="Center">
                          <TextBox.Style>
                            <!-- Selectable (mirrors SelectableText), with root rows brighter.
                                 Inlined rather than BasedOn: the codebase resolves styles via
                                 DynamicResource, and BasedOn only takes StaticResource. -->
                            <Style TargetType="TextBox">
                              <Setter Property="IsReadOnly" Value="True" />
                              <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                              <Setter Property="IsTabStop" Value="False" />
                              <Setter Property="AcceptsReturn" Value="False" />
                              <Setter Property="TextWrapping" Value="NoWrap" />
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderThickness" Value="0" />
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="Margin" Value="0" />
                              <Setter Property="Cursor" Value="IBeam" />
                              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                              <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                              <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                              <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource TitleTextPrimary}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="1" Style="{DynamicResource SelectableText}" Text="{Binding SizeText}"
                                 FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource BodyTextSecondary}"
                                 Margin="10,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Live job log -->
          <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource TerminalBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ProgressBar x:Name="DetailProgress" Grid.Row="0" Height="3" Minimum="0" Maximum="100"
                           Style="{DynamicResource ThinProgressBar}"
                           Visibility="Collapsed" Background="Transparent">
                <!-- Arcane dash-meter fill: primary -> violet gradient -->
                <ProgressBar.Foreground>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource WindowBorderPrimaryColor}" Offset="1" />
                  </LinearGradientBrush>
                </ProgressBar.Foreground>
              </ProgressBar>
              <!-- Wrap + no horizontal scrollbar: the themed ScrollBar template is
                   vertical-only, so a horizontal bar renders as a stray white box. -->
              <TextBox x:Name="txtDetailLog" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource TerminalText}" FontFamily="{DynamicResource FontMono}" FontSize="12"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6" />
            </Grid>
          </Border>
        </Grid>

        <!-- ===== User Lens: directory info + SCCM devices (shown when a user is picked) ===== -->
        <Grid x:Name="LensPanel">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DetailMode}" Value="Person">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <!-- Visibility (above) stays on HomeVm.DetailMode; the content binds the person VM. -->
          <Grid DataContext="{Binding SelectedPerson}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplayName}" FontFamily="{DynamicResource FontSans}" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TitleTextPrimary}" />
              <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Upn}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
                       Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Loading / error status -->
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource BodyTextTertiary}" />
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentOrange}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!-- User information -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="EMAIL" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Email}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <TextBlock Text="MANAGER" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Manager}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="SAM" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Sam}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="OFFICE" Style="{DynamicResource MicroLabel}" />
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Office}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <!-- Devices -->
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="DEVICES" Style="{DynamicResource MicroLabel}"
                         Margin="0,0,0,8" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Name}" FontFamily="{DynamicResource FontSans}" FontSize="13.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TitleTextPrimary}" />
                            <TextBox Style="{DynamicResource SelectableText}" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0">
                              <TextBox.Text>
                                <MultiBinding StringFormat="{}{0}   ·   {1}">
                                  <Binding Path="Os" />
                                  <Binding Path="LastSeenText" />
                                </MultiBinding>
                              </TextBox.Text>
                            </TextBox>
                            <!-- BitLocker key: hidden until revealed (a recovery secret); selectable to copy -->
                            <TextBox Style="{DynamicResource SelectableText}" Text="{Binding BitLockerText}" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                     Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap" Margin="0,6,0,0"
                                     Visibility="{Binding IsBitLockerRevealed, Converter={StaticResource BoolToVis}}" />
                            <!-- Note when there's no BitLocker / device not found -->
                            <TextBox Text="{Binding Note}" FontFamily="{DynamicResource FontSans}" FontSize="11" Foreground="{DynamicResource BodyTextTertiary}" Margin="0,4,0,0">
                              <TextBox.Style>
                                <!-- Selectable (mirrors SelectableText) + Wrap; collapses when empty. -->
                                <Style TargetType="TextBox">
                                  <Setter Property="IsReadOnly" Value="True" />
                                  <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                                  <Setter Property="IsTabStop" Value="False" />
                                  <Setter Property="AcceptsReturn" Value="False" />
                                  <Setter Property="TextWrapping" Value="Wrap" />
                                  <Setter Property="Background" Value="Transparent" />
                                  <Setter Property="BorderThickness" Value="0" />
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="Cursor" Value="IBeam" />
                                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                  <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                                  <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBox.Style>
                            </TextBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Wrapped so visibility can trigger (HasBitLocker &amp; not yet revealed)
                                 without restyling the themed button, whose style is a runtime
                                 (merged-dictionary) DynamicResource. -->
                            <ContentControl Margin="0,0,6,0">
                              <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBitLocker}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBitLockerRevealed}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ContentControl.Style>
                              <Button Content="Reveal key" Command="{Binding RevealCommand}"
                                      Style="{DynamicResource ButtonTintInfo}" FontSize="11" Height="28" />
                            </ContentControl>
                            <!-- QR of the latest recovery key: shown whenever the device has
                                 BitLocker (an alternate reveal - stays available after reveal). -->
                            <ContentControl Margin="0,0,6,0"
                                            Visibility="{Binding HasBitLocker, Converter={StaticResource BoolToVis}}">
                              <Button Content="QR" Command="{Binding ShowQrCommand}"
                                      Style="{DynamicResource ButtonTintInfo}" FontSize="11" Height="28"
                                      ToolTip="Show a QR code of the latest BitLocker recovery key" />
                            </ContentControl>
                            <Button Content="Add" Command="{Binding AddCommand}"
                                    Style="{DynamicResource ButtonTintPrimary}" FontSize="11" Height="28" Padding="14,4"
                                    ToolTip="Add this machine to the list" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Empty-devices hint (only once loaded with no devices) -->
              <TextBlock Grid.Row="1" Text="No SCCM devices for this user."
                         Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasDevices}" Value="False" />
                          <Condition Binding="{Binding IsLoading}" Value="False" />
                          <Condition Binding="{Binding HasError}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Grid>

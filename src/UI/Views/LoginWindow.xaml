<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource PrimaryBackground}"
        AllowsTransparency="False"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Popup chrome contract, same recipe as DialogWindow. -->
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource PanelBorder}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,0.75">
                <GradientStop Color="{DynamicResource PrimaryBackgroundDarkColor}"
                              Offset="0" />
                <GradientStop Color="{DynamicResource PrimaryBackgroundColor}"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="panelControlBar"
                  Grid.Row="0"
                  Background="Transparent"
                  Height="48">
                <TextBlock Text="Sign in to GitHub"
                           Style="{DynamicResource TextPaneTitle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="24,0,106,0" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FlowDirection="RightToLeft">
                    <Button x:Name="btnClose"
                            Height="36"
                            Style="{DynamicResource controlButton}"
                            Tag="{DynamicResource Destructive}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Style="{DynamicResource controlButtonIcon}"
                              Data="{DynamicResource xMark}" />
                    </Button>
                    <Button x:Name="btnMinimize"
                            Height="36"
                            Style="{DynamicResource controlButton}"
                            Tag="{DynamicResource TitleTextPrimary}"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Path Style="{DynamicResource controlButtonIcon}"
                              Width="13"
                              StrokeThickness="1.08"
                              Data="{DynamicResource Minimize}" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Style="{DynamicResource TextBody}"
                       Margin="24,6,24,0"
                       TextWrapping="Wrap"
                       Text="Update checks use a private GitHub repository, so sign in once. The button opens github.com and shows a device code to enter." />

            <!-- The device flow writes its verification URL and user code here. -->
            <Border Grid.Row="2"
                    Margin="24,16,24,0"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource PanelBorder}"
                    Background="{DynamicResource PanelBackground}"
                    MinHeight="96">
                <TextBox x:Name="Output"
                         Text="{Binding OutputText, Mode=OneWay}"
                         Margin="10"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         IsTabStop="False"
                         FontFamily="{DynamicResource FontMono}"
                         FontSize="13"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10"
                         Foreground="{DynamicResource TitleTextPrimary}" />
            </Border>

            <Grid Grid.Row="3"
                  Margin="24,16,24,20">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{DynamicResource FontSans}"
                           FontSize="12"
                           Foreground="{DynamicResource TitleTextSecondary}">
                    <Run Text="New to GitHub? " />
                    <Hyperlink x:Name="AccessLink"
                               NavigateUri="https://github.com/signup"
                               Foreground="{DynamicResource AccentPurpleLight}"
                               FocusVisualStyle="{DynamicResource FocusRingVisual}"
                               TextDecorations="None">Create an account</Hyperlink>
                </TextBlock>
                <Button Command="{Binding AuthCommand}"
                        Content="Sign in with GitHub"
                        Style="{DynamicResource ButtonTintPrimary}"
                        Height="32"
                        MinWidth="150"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>

<!-- Config form chrome, hosted in the settings overlay card. MainCommandComboBox and
     ConfigOptionsContent are looked up by name; Save binds the ConfigViewModel. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock Text="Configuration"
               FontFamily="Montserrat"
               FontSize="18"
               FontWeight="Bold"
               Foreground="{DynamicResource TitleTextPrimary}"
               Margin="0,0,0,14" />
    <TextBlock Text="COMMAND"
               Style="{DynamicResource SettingsSectionLabel}" />
    <ComboBox x:Name="MainCommandComboBox"
              Width="220"
              HorizontalAlignment="Left"
              Style="{DynamicResource ModernComboBox}"
              Margin="0,0,0,16">
        <ComboBoxItem Content="Scan" />
        <ComboBoxItem Content="Apply Updates" />

        <!-- Commented out after discussion with leadership -->
        <!-- <ComboBoxItem Content="Configure" />
        <ComboBoxItem Content="Custom Notification" />
        <ComboBoxItem Content="Driver Install" />
        <ComboBoxItem Content="Generate Encrypted Password" />
        <ComboBoxItem Content="Help" />
        <ComboBoxItem Content="Version" /> -->
    </ComboBox>
    <ContentControl x:Name="ConfigOptionsContent" />
    <Button x:Name="btnSaveConfig"
            Content="Save"
            Command="{Binding SaveCommand}"
            Style="{DynamicResource ButtonPrimary}"
            HorizontalAlignment="Right"
            Margin="0,16,0,0" />
</StackPanel>

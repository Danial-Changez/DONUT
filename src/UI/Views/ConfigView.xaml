<!-- Config form chrome, hosted in the settings overlay card. The command segments and
     ConfigOptionsContent are looked up by name; Save binds the ConfigViewModel. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Command picker: a segmented pill; the presenter loads the matching view. -->
    <Border CornerRadius="9"
            Background="{DynamicResource Secondary}"
            Padding="3"
            HorizontalAlignment="Center"
            Margin="0,4,0,16">
        <!-- UniformGrid = equal-width segments (Apple HIG): unequal widths would imply
             unequal importance, and the control's footprint stays stable. -->
        <UniformGrid Rows="1">
            <RadioButton x:Name="cmdGeneral"
                         Content="General"
                         GroupName="cmd"
                         Style="{DynamicResource SegmentToggle}" />
            <RadioButton x:Name="cmdScan"
                         Content="Scan"
                         GroupName="cmd"
                         Style="{DynamicResource SegmentToggle}" />
            <RadioButton x:Name="cmdApplyUpdates"
                         Content="Apply"
                         GroupName="cmd"
                         Style="{DynamicResource SegmentToggle}" />
        </UniformGrid>
    </Border>
    <ContentControl x:Name="ConfigOptionsContent" />
    <Button x:Name="btnSaveConfig"
            Content="Save"
            Command="{Binding SaveCommand}"
            Style="{DynamicResource ButtonTintPrimary}"
            HorizontalAlignment="Center"
            Width="200"
            Margin="0,16,0,0" />
</StackPanel>

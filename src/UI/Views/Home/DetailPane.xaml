<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================ Detail pane ============================ -->
<Border
  x:Name="DetailPane"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  CornerRadius="10" Padding="2"
  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
  <Border.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Border.Resources>
  <!-- Three modes, switched by HomeVm.DetailMode: Empty hint / Machine detail / user Lens. -->
  <Grid Margin="14,12,14,12">
    <TextBlock Text="Select a machine, or search a person to open their Lens."
               Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="14"
               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DetailMode}" Value="Empty">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DetailMode}" Value="Machine">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <!-- MaxHeight caps the cards row so a taller window grows the terminal instead. -->
        <RowDefinition Height="*" MaxHeight="400" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Job progress lives on the terminal's bar below, never in this header. -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <!-- Tag is HostName, never DetailTitle, which appends an offline suffix for display. -->
          <TextBox Style="{DynamicResource CopyableValue}" Text="{Binding SelectedMachine.DetailTitle}"
                   Tag="{Binding SelectedMachine.HostName}"
                   FontFamily="{DynamicResource FontSans}" FontSize="18"
                   FontWeight="Bold" Foreground="{DynamicResource TitleTextPrimary}" />
          <!-- IP only, since probe freshness already shows on the machine card. -->
          <TextBox Style="{DynamicResource CopyableValue}" Text="{Binding SelectedMachine.DetailIp}"
                   Tag="{Binding SelectedMachine.DetailIp}"
                   FontFamily="{DynamicResource FontSans}" FontSize="11"
                   Foreground="{DynamicResource BodyTextTertiary}" Margin="-4,2,0,0" />
        </StackPanel>
        <!-- Utility actions subordinate to Run, so colour stays with status and the primary. -->
        <Button x:Name="btnFindFolders" Grid.Column="1" Content="Storage"
                Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Width="124" Height="32" Margin="6,0,0,0" />
        <Button x:Name="btnDetailRefresh" Grid.Column="2" Content="Refresh"
                Style="{DynamicResource ButtonSecondary}" FontSize="12.5" Width="110" Height="32" Margin="6,0,0,0" />
      </Grid>

      <!-- Updates and disk usage sit side by side so both read at once. Each card fills
           from its own scan, scrolls on its own, and shows a hint until it has data. -->
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.25*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

      <!-- Display only, the apply is gated by a separate confirm dialog. -->
      <Border Grid.Column="0" CornerRadius="10" Padding="14,12"
              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- The pill keeps the identity verdict glanceable, full sentence in its tooltip. -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="AVAILABLE UPDATES"
                       Style="{DynamicResource MicroLabel}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" CornerRadius="8.4" Padding="8,1" BorderThickness="1"
                    VerticalAlignment="Center"
                    ToolTip="{Binding SelectedMachine.UpdatesIdentityText}"
                    Visibility="{Binding SelectedMachine.HasUpdates, Converter={StaticResource BoolToVis}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource TintAmber}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource TintAmberBorder}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Match">
                      <Setter Property="Background" Value="{DynamicResource TintGreen}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource TintGreenBorder}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Mismatch">
                      <Setter Property="Background" Value="{DynamicResource TintRed}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource TintRedBorder}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource FontSans}"
                         FontSize="10" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="UNVERIFIED" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentYellow}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Match">
                        <Setter Property="Text" Value="VERIFIED" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding SelectedMachine.IdentityState}" Value="Mismatch">
                        <Setter Property="Text" Value="WRONG MACHINE" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" VerticalAlignment="Top"
                     Text="Run a scan to list this machine's updates."
                     Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                     TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedMachine.HasUpdates}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding SelectedMachine.HasUpdates, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding SelectedMachine.Updates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource PanelBackgroundHover}" BorderBrush="{DynamicResource PanelBorder}"
                          BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{DynamicResource FontSans}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TitleTextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Name}" />
                        <!-- Inline style, not BasedOn, so the badge colour can vary per urgency. -->
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                CornerRadius="8.4" Padding="8,0" Height="20" BorderThickness="1">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource TintSky}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource TintSkyBorder}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Urgency}" Value="Urgent">
                                  <Setter Property="Background" Value="{DynamicResource TintRed}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource TintRedBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Urgency}" Value="Optional">
                                  <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Urgency}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding Urgency}" VerticalAlignment="Center"
                                     FontFamily="{DynamicResource FontSans}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentCyan}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Urgency}" Value="Urgent">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Urgency}" Value="Optional">
                                    <Setter Property="Foreground" Value="{DynamicResource BodyTextPrimary}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Style="{DynamicResource BadgeMuted}" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource BadgeMutedText}" Text="{Binding Category}" />
                          </Border>
                          <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource FontMono}" FontSize="11"
                                     Foreground="{DynamicResource BodyTextPrimary}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}" />
                          <Border Style="{DynamicResource BadgeGreen}" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{DynamicResource BadgeGreenText}" Text="NEW" />
                          </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}" FontSize="11"
                                   Foreground="{DynamicResource BodyTextTertiary}" Margin="10,0,0,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Fills only when the Storage button runs, never as part of a normal scan. -->
      <Border Grid.Column="2" CornerRadius="10" Padding="14,12"
              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Red is earned here, the action permanently removes the folders' contents. -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LARGEST FOLDERS ON C:" Style="{DynamicResource MicroLabel}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            <Button Grid.Column="1" x:Name="btnDeleteFolders" Content="Clear Selected"
                    Style="{DynamicResource ButtonTintDestructive}" FontSize="11" Height="26" Padding="10,0"
                    Visibility="{Binding SelectedMachine.HasFolders, Converter={StaticResource BoolToVis}}"
                    ToolTip="Permanently empties the checked folders (the folders stay)" />
          </Grid>
          <TextBlock Grid.Row="1"
                     Text="Click &quot;Storage&quot; to fill this list."
                     Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                     TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedMachine.HasFolders}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="DiskFoldersList"
                      Style="{DynamicResource DiskTree}"
                      ItemContainerStyle="{DynamicResource DiskTreeItem}"
                      ItemsSource="{Binding SelectedMachine.Folders}"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                      <!-- Auto, not fixed: a hidden checkbox collapses to 0 so protected rows sit flush. -->
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Shown only on clearable folders, two-way bound so the presenter reads it. -->
                    <CheckBox Grid.Column="0" Style="{DynamicResource ModernCheckBox}" Margin="0,0,3,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                              Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                              ToolTip="Clear this folder's contents" />
                    <TextBox Grid.Column="1" Style="{DynamicResource SelectableTreeLabel}"
                             Text="{Binding Label}" ToolTip="{Binding Path}"
                             FontFamily="{DynamicResource FontSans}" FontSize="12" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Style="{DynamicResource SelectableText}" Text="{Binding SizeText}"
                             FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource BodyTextSecondary}"
                             Margin="10,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </ScrollViewer>
        </Grid>
      </Border>
      </Grid>

      <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource TerminalBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ProgressBar x:Name="DetailProgress" Grid.Row="0" Height="3" Minimum="0" Maximum="100"
                       Style="{DynamicResource ThinProgressBar}"
                       Visibility="Collapsed" Background="Transparent">
            <ProgressBar.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" />
                <GradientStop Color="{DynamicResource AccentPurpleColor}" Offset="1" />
              </LinearGradientBrush>
            </ProgressBar.Foreground>
          </ProgressBar>
          <!-- No horizontal scrollbar: the themed ScrollBar template is vertical only, so one
               would render as a stray white box. Virtualized so 2000 lines stay cheap. -->
          <ListBox x:Name="lstDetailLog" Grid.Row="1" Background="Transparent" BorderThickness="0"
                   Grid.IsSharedSizeScope="True"
                   FontFamily="{DynamicResource FontMono}" FontSize="12" Margin="6" IsTabStop="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <!-- No hover/selected chrome: the row is plain text, not a pickable item -->
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- Two cells, not two Runs: a wrapped line used to reflow under the stamp. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <!-- Shared group: unstamped separator lines must not collapse the column. -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogStamp" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding StampText, Mode=OneTime}"
                             Foreground="{DynamicResource BodyTextTertiary}" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayText, Mode=OneTime}" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TerminalText}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Severity, Mode=OneTime}" Value="Error">
                            <Setter Property="Foreground" Value="{DynamicResource AccentRed}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Severity, Mode=OneTime}" Value="Warn">
                            <Setter Property="Foreground" Value="{DynamicResource AccentYellow}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Severity, Mode=OneTime}" Value="Success">
                            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Per-line rendering costs cross-line drag-selection, so Copy replaces it. -->
          <!-- Right inset 20 clears the 7px scrollbar riding the list's edge. -->
          <Button x:Name="btnCopyLog" Grid.Row="1" Panel.ZIndex="1"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,20,0"
                  Style="{DynamicResource ButtonSecondary}" Width="28" Height="24" Padding="0"
                  Opacity="0.85" ToolTip="Copy log">
            <Path Data="{DynamicResource Copy}" Style="{DynamicResource lucideIcon}"
                  Stroke="{DynamicResource SecondaryForeground}"
                  Width="12" Height="12" StrokeThickness="1" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- User Lens from Home/LensPane.xaml, whose root owns the Person-mode trigger. -->
    <ContentControl x:Name="slotLens" Focusable="False" IsTabStop="False" />
  </Grid>
</Border>

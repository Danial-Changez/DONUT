<?xml version="1.0" encoding="UTF-8"?>
<!-- Machine list -->
<Border
  x:Name="MachinePanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  CornerRadius="10" Padding="2"
  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
  <Border.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Mirrors the detail pane's [title | buttons] row so the two panes read as a pair. -->
    <Grid Grid.Row="0" Margin="14,12,14,10">
      <TextBlock Text="Machines" Style="{DynamicResource TextPaneTitle}"
                 HorizontalAlignment="Left" VerticalAlignment="Center" />
      <Button x:Name="btnClearTabs" Content="Clear" Style="{DynamicResource ButtonSecondary}"
              FontSize="12" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
              ToolTip="Remove machines that are not running" />
    </Grid>

    <!-- Not wrapped in a ScrollViewer: the ListBox owns one, and that is what virtualizes. -->
    <Grid Grid.Row="1" Margin="10,0,10,10">
      <!-- SelectedItem stays unbound: a PS-class auto-property raises no PropertyChanged when
           WPF writes it, so the presenter calls SetSelected() from SelectionChanged instead. -->
      <ListBox x:Name="MachineList"
               ItemsSource="{Binding Machines}"
               Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ItemContainerStyle="{DynamicResource MachineListItem}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8" CornerRadius="10"
                    Padding="14,10,8,10" HorizontalAlignment="Stretch" Cursor="Hand">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource RowSeparator}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource RowHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <!-- Double-click gathers fresh inventory, a single click only selects. -->
              <Border.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GatherCommand}" />
              </Border.InputBindings>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0"
                         VerticalAlignment="Center" Fill="{Binding DotBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TitleTextPrimary}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}" />
                    <!-- The SCCM primary user, collapsed when SCCM has none on record. -->
                    <TextBlock Text="{Binding OwnerName, StringFormat=({0})}"
                               Foreground="{DynamicResource BodyTextTertiary}"
                               FontFamily="{DynamicResource FontSans}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,1,0,0"
                               ToolTip="{Binding OwnerTip}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding OwnerName}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OwnerTip}" Value="">
                              <Setter Property="ToolTipService.IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource BodyTextTertiary}"
                             FontFamily="{DynamicResource FontMono}" FontSize="10.5"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                </StackPanel>
                <!-- No progress bar here, the live one sits atop the detail pane's terminal. -->
                <Border Grid.Column="2" CornerRadius="8.4" Padding="8,2" VerticalAlignment="Center"
                        Margin="16,0,8,0" Background="{Binding ChipBackground}"
                        BorderBrush="{Binding ChipBorderBrush}" BorderThickness="1"
                        Visibility="{Binding ChipVisible, Converter={StaticResource BoolToVis}}">
                  <!-- Glyph plus label so status is not colour alone. Pinned font avoids tofu. -->
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding ChipForeground}"
                               FontFamily="{DynamicResource FontSymbol}" FontWeight="SemiBold" FontSize="11"
                               Margin="0,0,5,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipForeground}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <!-- No tooltip: the button says Run, and the mode pill says which. -->
                <Button Grid.Column="3" Content="Run" Command="{Binding RunCommand}"
                        Style="{DynamicResource ButtonTintSuccess}" FontSize="11" Height="32"
                        Padding="14,4" VerticalAlignment="Center" />
                <!-- Removes one card, while a running host toasts and stays instead. -->
                <Button Grid.Column="4" Command="{Binding RemoveCommand}"
                        Style="{DynamicResource fieldClearButton}" Margin="6,0,0,0"
                        VerticalAlignment="Center" ToolTip="Remove from the list" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- Blank slate: a first-time user has no machines, so spell out how to start. -->
      <StackPanel
        x:Name="FleetEmptyHint"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        MaxWidth="520"
        Margin="24"
        IsHitTestVisible="False"
      >
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Machines.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="No machines yet"
                   Foreground="{DynamicResource TitleTextSecondary}"
                   FontFamily="{DynamicResource FontSans}" FontSize="16" FontWeight="SemiBold"
                   TextAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Foreground="{DynamicResource BodyTextTertiary}"
                   FontFamily="{DynamicResource FontSans}" FontSize="13"
                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="20">
          <Run Text="1.  Search a machine, Enter adds the top match." />
          <LineBreak />
          <Run Text="2.  Paste several names to add them at once." />
          <LineBreak />
          <Run Text="3.  Or search a person to open their Lens." />
          <LineBreak />
          <Run Text="4.  Run, or Run All, to scan or apply updates." />
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Border>

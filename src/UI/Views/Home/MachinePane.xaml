<?xml version="1.0" encoding="UTF-8"?>
<!-- Machine list -->
<Border
  x:Name="MachinePanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  CornerRadius="10" Padding="2"
  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
  <Border.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- List header: a pane title (matching the detail pane's hostname title, 18px bold) with
         Clear (completed) as the right-aligned action, mirroring the detail pane's
         [title | buttons] row so the two panes read as a balanced pair (same top offset 14). -->
    <Grid Grid.Row="0" Margin="14,12,14,10">
      <TextBlock Text="Machines" Style="{DynamicResource TextPaneTitle}"
                 HorizontalAlignment="Left" VerticalAlignment="Center" />
      <Button x:Name="btnClearTabs" Content="Clear" Style="{DynamicResource ButtonSecondary}"
              FontSize="12" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
              ToolTip="Clear completed machines from the list" />
    </Grid>

    <!-- Rows (MVVM: a virtualizing ListBox bound to HomeViewModel.Machines; each item is
         a HostViewModel rendered by the DataTemplate below). The ListBox owns its own
         ScrollViewer, so it is NOT wrapped in one - that is what enables virtualization. -->
    <Grid Grid.Row="1" Margin="10,0,10,10">
      <!-- SelectedItem is NOT bound to SelectedMachine: a PS-class auto-property doesn't
           raise PropertyChanged when WPF writes it, so the SelectedMachine.* detail/overview
           bindings wouldn't track selection. The presenter drives HomeVm.SelectedMachine via
           SetSelected() (which raises) from SelectionChanged instead; the ListBox's own
           SelectedItem still owns the row highlight. -->
      <ListBox x:Name="MachineList"
               ItemsSource="{Binding Machines}"
               Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               ItemContainerStyle="{DynamicResource MachineListItem}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border x:Name="rowBorder" Margin="0,0,0,8" CornerRadius="10"
                    Padding="14,10,8,10" HorizontalAlignment="Stretch" Cursor="Hand">
              <!-- Arcane table-row states: quiet resting row, violet-tinted hover,
                   stronger violet tint + primary edge when selected. -->
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource RowSeparator}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource RowHover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <!-- Double-click a row to gather fresh inventory (single click selects). -->
              <Border.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GatherCommand}" />
              </Border.InputBindings>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0"
                         VerticalAlignment="Center" Fill="{Binding DotBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TitleTextPrimary}"
                             FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource BodyTextTertiary}"
                             FontFamily="{DynamicResource FontMono}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Subtitle}" />
                </StackPanel>
                <!-- The card reads busy from the "Scanning..." chip; the live bar sits atop
                     the detail pane's terminal (DetailProgress), not here (declutter). -->
                <!-- Status chip = Arcane StatusBadge: rounded (not a pill), tinted
                     fill + 30% border, 400-shade text (all VM-driven). -->
                <Border Grid.Column="2" CornerRadius="8.4" Padding="8,2" VerticalAlignment="Center"
                        Margin="16,0,8,0" Background="{Binding ChipBackground}"
                        BorderBrush="{Binding ChipBorderBrush}" BorderThickness="1"
                        Visibility="{Binding ChipVisible, Converter={StaticResource BoolToVis}}">
                  <!-- Glyph + label so status reads by shape, not colour alone. Segoe UI
                       Symbol is pinned so the symbols never fall back to tofu. -->
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding ChipForeground}"
                               FontFamily="{DynamicResource FontSymbol}" FontWeight="SemiBold" FontSize="11"
                               Margin="0,0,5,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipForeground}"
                               FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Button Grid.Column="3" Content="Run" Command="{Binding RunCommand}"
                        Style="{DynamicResource ButtonTintSuccess}" FontSize="11" Height="32"
                        Padding="14,4" VerticalAlignment="Center"
                        ToolTip="Run the active command on this machine" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- Blank slate: a first-time user has no machines, so spell out how to start. -->
      <StackPanel
        x:Name="FleetEmptyHint"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        MaxWidth="520"
        Margin="24"
        IsHitTestVisible="False"
      >
        <TextBlock Text="No machines yet"
                   Foreground="{DynamicResource TitleTextSecondary}"
                   FontFamily="{DynamicResource FontSans}" FontSize="16" FontWeight="SemiBold"
                   TextAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Foreground="{DynamicResource BodyTextTertiary}"
                   FontFamily="{DynamicResource FontSans}" FontSize="13"
                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="20">
          <Run Text="1.  Add machines: paste names, then Enter." />
          <LineBreak />
          <Run Text="2.  Or search a name to open its Lens." />
          <LineBreak />
          <Run Text="3.  Run (or Run all) to scan or apply updates." />
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Border>

<?xml version="1.0" encoding="UTF-8"?>
<!-- ===== User Lens: directory info and the user's SCCM devices ===== -->
<Grid
  x:Name="LensPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Grid.Resources>
  <Grid.Style>
    <Style TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DetailMode}" Value="Person">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Grid.Style>
  <!-- Visibility stays on HomeVm.DetailMode while the content binds the person VM. -->
  <Grid DataContext="{Binding SelectedPerson}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBox Style="{DynamicResource SelectableText}" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
               FontFamily="{DynamicResource FontSans}" FontSize="18" FontWeight="Bold"
               Foreground="{DynamicResource TitleTextPrimary}" />
      <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Upn}" FontFamily="{DynamicResource FontSans}" FontSize="11.5"
               Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" ToolTip="{Binding Upn}" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontFamily="{DynamicResource FontSans}" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,10">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource BodyTextTertiary}" />
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource AccentOrange}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
        <TextBlock Text="EMAIL" Style="{DynamicResource MicroLabel}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Email}" ToolTip="{Binding Email}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
        <TextBlock Text="MANAGER" Style="{DynamicResource MicroLabel}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Manager}" ToolTip="{Binding Manager}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
        <TextBlock Text="SAM" Style="{DynamicResource MicroLabel}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Sam}" ToolTip="{Binding Sam}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1">
        <TextBlock Text="OFFICE" Style="{DynamicResource MicroLabel}" />
        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Office}" ToolTip="{Binding Office}" FontFamily="{DynamicResource FontSans}" FontSize="13" Foreground="{DynamicResource TitleTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ListLabel}" Style="{DynamicResource MicroLabel}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleSoftwareCommand}"
                Style="{DynamicResource ButtonSecondary}" FontSize="11" Height="32"
                ToolTip="Application deployments targeted at this user" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSoftwareShown}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                      Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Name}" FontFamily="{DynamicResource FontSans}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TitleTextPrimary}" ToolTip="{Binding Name}" />
                    <!-- Model leads because it is what separates a person's machines. -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                ToolTip="{Binding DetailTip}">
                      <!-- Value and separator collapse together, so a missing one leaves no dot. -->
                      <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Model}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Model}"
                                 FontFamily="{DynamicResource FontSans}" FontSize="12"
                                 Foreground="{DynamicResource TitleTextPrimary}" />
                        <TextBlock Text="   ·   " FontFamily="{DynamicResource FontSans}" FontSize="12"
                                   Foreground="{DynamicResource BodyTextTertiary}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding TagText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <!-- Mono: a service tag is read off a sticker, where 0/O and 1/I must differ. -->
                        <TextBox Style="{DynamicResource SelectableText}" Text="{Binding TagText}"
                                 FontFamily="{DynamicResource FontMono}" FontSize="11"
                                 Foreground="{DynamicResource BodyTextTertiary}" />
                        <TextBlock Text="   ·   " FontFamily="{DynamicResource FontSans}" FontSize="12"
                                   Foreground="{DynamicResource BodyTextTertiary}" />
                      </StackPanel>
                      <TextBox Style="{DynamicResource SelectableText}" Text="{Binding LastSeenText}"
                               FontFamily="{DynamicResource FontSans}" FontSize="12"
                               Foreground="{DynamicResource BodyTextTertiary}" />
                    </StackPanel>
                    <!-- A recovery secret, so it stays hidden until revealed, and selectable to copy. -->
                    <TextBox Style="{DynamicResource SelectableText}" Text="{Binding BitLockerText}" FontFamily="{DynamicResource FontMono}" FontSize="12"
                             Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding IsBitLockerRevealed, Converter={StaticResource BoolToVis}}" />
                    <!-- The note explains a missing key or a device SCCM could not find. -->
                    <TextBox Text="{Binding Note}" FontFamily="{DynamicResource FontSans}" FontSize="11" Foreground="{DynamicResource BodyTextTertiary}" Margin="0,4,0,0">
                      <TextBox.Style>
                        <!-- Inlined rather than BasedOn on SelectableText, which needs StaticResource. -->
                        <Style TargetType="TextBox">
                          <Setter Property="IsReadOnly" Value="True" />
                          <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                          <Setter Property="IsTabStop" Value="False" />
                          <Setter Property="AcceptsReturn" Value="False" />
                          <Setter Property="TextWrapping" Value="Wrap" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Cursor" Value="IBeam" />
                          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                          <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                          <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <Trigger Property="Text" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Wrapped so visibility can trigger without overriding the themed style. -->
                    <ContentControl Margin="0,0,6,0">
                      <ContentControl.Style>
                        <Style TargetType="ContentControl">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBitLocker}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBitLockerRevealed}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ContentControl.Style>
                      <!-- Neutral utilities, so Add keeps the row's one tint. -->
                      <Button Content="Reveal Key" Command="{Binding RevealCommand}"
                              Style="{DynamicResource ButtonSecondary}" FontSize="11" Height="32"
                              ToolTip="Latest BitLocker recovery key" />
                    </ContentControl>
                    <!-- Stays available after a reveal, since it is an alternate way to read the key. -->
                    <ContentControl Margin="0,0,6,0"
                                    Visibility="{Binding HasBitLocker, Converter={StaticResource BoolToVis}}">
                      <Button Content="QR" Command="{Binding ShowQrCommand}"
                              Style="{DynamicResource ButtonSecondary}" FontSize="11" Height="32"
                              ToolTip="QR of the BitLocker recovery key" />
                    </ContentControl>
                    <Button Content="Add" Command="{Binding AddCommand}"
                            Style="{DynamicResource ButtonTintPrimary}" FontSize="11" Height="32" Padding="14,4"
                            ToolTip="Add to the machine list" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Deployments}"
                      Visibility="{Binding IsSoftwareShown, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The collection name shows verbatim, the install/application filter went generic. -->
              <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Software}" ToolTip="{Binding Software}"
                           FontFamily="{DynamicResource FontSans}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleTextPrimary}" />
                  <!-- Separator and program collapse together, and only package rows carry one. -->
                  <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Program}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="   ·   " FontFamily="{DynamicResource FontSans}" FontSize="12"
                               Foreground="{DynamicResource BodyTextTertiary}" />
                    <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Program}" ToolTip="{Binding Program}"
                             FontFamily="{DynamicResource FontSans}" FontSize="12"
                             Foreground="{DynamicResource BodyTextTertiary}" />
                  </StackPanel>
                </StackPanel>
                <TextBox Style="{DynamicResource SelectableText}" Text="{Binding Collection}" ToolTip="{Binding Collection}"
                         FontFamily="{DynamicResource FontSans}" FontSize="11"
                         Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
      </ScrollViewer>
      <TextBlock Grid.Row="1" Text="No SCCM devices."
                 Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasDevices}" Value="False" />
                  <Condition Binding="{Binding IsLoading}" Value="False" />
                  <Condition Binding="{Binding HasError}" Value="False" />
                  <Condition Binding="{Binding IsSoftwareShown}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <!-- One line covers the software view's loading, error and empty states. -->
      <TextBlock Grid.Row="1" Text="{Binding SoftwareStatusText}"
                 Foreground="{DynamicResource BodyTextTertiary}" FontFamily="{DynamicResource FontSans}" FontSize="12"
                 TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSoftwareShown}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <!-- Last trigger wins, so a blank status stays hidden in the software view too. -->
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</Grid>

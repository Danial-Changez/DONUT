<?xml version="1.0" encoding="UTF-8"?>
<!-- ============= Overview strip: mirrors the SELECTED remote machine ============= -->
<!-- Collapsed while the Lens is showing, since these stats are machine-only. -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Margin="0,0,0,18"
>
  <Grid.Style>
    <Style TargetType="Grid">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DetailMode}" Value="Person">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Grid.Style>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Margin="0,0,6,0" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="MACHINE" Style="{DynamicResource MicroLabel}" />
      <TextBox Text="{Binding SelectedMachine.OvModel, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvModel}"
                 Style="{DynamicResource StatValue}" />
      <TextBox Style="{DynamicResource CopyableValue}" Text="{Binding SelectedMachine.OvModelSub, FallbackValue='no machine selected'}"
               Tag="{Binding SelectedMachine.OvModelSubValue}" FontFamily="{DynamicResource FontSans}" FontSize="12"
               Foreground="{DynamicResource BodyTextTertiary}" Margin="-4,2,0,0" />
    </StackPanel>
  </Border>

  <Border Grid.Column="1" Margin="6,0,6,0" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="BATTERY HEALTH" Style="{DynamicResource MicroLabel}" />
      <TextBox Text="{Binding SelectedMachine.OvBattery, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvBattery}"
                 Style="{DynamicResource StatValue}" />
      <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvBatterySub}"
               ToolTip="{Binding SelectedMachine.OvBatterySub}" FontFamily="{DynamicResource FontSans}" FontSize="12"
               Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
    </StackPanel>
  </Border>

  <Border Grid.Column="2" Margin="6,0,6,0" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="DISK" Style="{DynamicResource MicroLabel}" />
      <TextBox Text="{Binding SelectedMachine.OvDisk, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvDisk}"
                 Style="{DynamicResource StatValue}" />
      <TextBox Style="{DynamicResource SelectableText}" Text="{Binding SelectedMachine.OvDiskSub}"
               ToolTip="{Binding SelectedMachine.OvDiskSub}" FontFamily="{DynamicResource FontSans}" FontSize="12"
               Foreground="{DynamicResource BodyTextTertiary}" Margin="0,2,0,0" />
    </StackPanel>
  </Border>

  <!-- BIOS, not the update count, which the machine card and updates card already show. -->
  <Border Grid.Column="3" Margin="6,0,0,0" Style="{DynamicResource Card}">
    <StackPanel>
      <TextBlock Text="BIOS" Style="{DynamicResource MicroLabel}" />
      <TextBox Text="{Binding SelectedMachine.OvBios, FallbackValue=—}" ToolTip="{Binding SelectedMachine.OvBios}"
                 Style="{DynamicResource StatValue}" />
    </StackPanel>
  </Border>
</Grid>

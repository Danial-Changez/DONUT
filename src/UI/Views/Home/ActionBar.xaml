<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================ Action bar ============================ -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Margin="0,0,0,16"
>
  <Grid.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>

  <!-- Add / run input: type or paste WSIDs (comma- or space-separated), Enter to add.
       One Arcane input surface - the bar carries the fill + focus ring; the icon and
       the transparent single-line field sit on it. Down/Up drive the finder dropdown. -->
  <Border
    x:Name="SearchBox"
    Grid.Column="0"
    BorderThickness="1"
    CornerRadius="8.4"
    Padding="12,0"
    Height="40"
  >
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputFill}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
            <Setter Property="Background" Value="{DynamicResource InputBorder}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="26" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path
        Data="{DynamicResource Search}"
        Height="16"
        Width="16"
        Stretch="Uniform"
        Fill="{DynamicResource BodyTextPrimary}"
        VerticalAlignment="Center"
        Grid.Column="0"
      />
      <TextBox
        x:Name="GoogleSearchBar"
        Style="{DynamicResource GoogleSearchBar}"
        Grid.Column="1"
        Margin="2,0,0,0"
        AcceptsReturn="False"
        TextWrapping="NoWrap"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Center"
        FontWeight="SemiBold"
      />
    </Grid>
  </Border>

  <!-- Live AD finder dropdown: computers (type-ahead for scan/run) + users (UPN, unlock when locked) -->
  <Popup x:Name="SearchResultsPopup"
         Grid.Column="0"
         PlacementTarget="{Binding ElementName=SearchBox}"
         Placement="Bottom"
         AllowsTransparency="True"
         StaysOpen="True"
         PopupAnimation="Fade"
         Width="{Binding ActualWidth, ElementName=SearchBox}">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="0,4,0,0"
            Padding="6"
            SnapsToDevicePixels="True">
      <!-- One flat list of SearchRowViewModels: section headers and result rows share
           the template, switched by IsHeader. A ListBox (not ItemsControl) so Down/Up
           from the search bar can drive SelectedIndex; selection highlights the row. -->
      <!-- CanContentScroll off = pixel scrolling: item scrolling leaves a dead band under
           the last row (viewport rounds to whole items), read as phantom padding. -->
      <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}"
               Background="Transparent" BorderThickness="0" MaxHeight="340"
               ItemContainerStyle="{DynamicResource MachineListItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="False">
        <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <!-- Section header ("COMPUTERS" / "USERS") -->
                <TextBlock Text="{Binding HeaderText}" FontFamily="{DynamicResource FontSans}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource BodyTextTertiary}"
                           Margin="6,6,0,4">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- Result row: click or Enter picks (computers go straight onto the machine
                     pane, users open the Lens); keyboard highlight mirrors hover. -->
                <Border CornerRadius="7" Padding="10,6,8,6" Margin="0,0,0,2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Add row shown but the text isn't a machine name: dim, still pickable. -->
                        <DataTrigger Binding="{Binding Dim}" Value="True">
                          <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                        </Trigger>
                        <!-- Keyboard-selected row = what Enter will do; violet so it reads at a glance. -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Border.InputBindings>
                    <!-- Null for user rows: the gesture is simply ignored. -->
                    <MouseBinding MouseAction="LeftClick" Command="{Binding PickCommand}" />
                  </Border.InputBindings>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- "+" badge for the Add-as-a-machine action row only -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0"
                            VerticalAlignment="Center" Background="{DynamicResource PanelBackgroundActive}"
                            Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="+" FontFamily="{DynamicResource FontSans}" FontSize="15" FontWeight="Bold"
                                 Foreground="{DynamicResource AccentPurpleLight}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Primary}" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                 Foreground="{DynamicResource TitleTextPrimary}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Primary}" />
                      <TextBlock Text="{Binding Secondary}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,1,0,0"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}" />
                    </StackPanel>
                    <!-- Grey utility (one tint per row - Unlock keeps it when shown):
                         opens the shell's temp-password reset overlay. -->
                    <Button Grid.Column="2" Content="Reset..." Command="{Binding ResetCommand}"
                            Style="{DynamicResource ButtonSecondary}" Height="32" FontSize="11"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTip="Set a temporary password"
                            Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />
                    <!-- The row's one action earns the tint (colour hierarchy); Outline is
                         reserved for low-emphasis navigation (tour Back). -->
                    <Button Grid.Column="3" Content="Unlock" Command="{Binding UnlockCommand}"
                            Style="{DynamicResource ButtonTintPrimary}" Height="32" FontSize="11"
                            VerticalAlignment="Center"
                            ToolTip="Unlock this account"
                            Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Popup>

  <!-- Quick mode cycle: click to switch the active command, using its defaults -->
  <Button
    x:Name="btnMode"
    Grid.Column="1"
    VerticalAlignment="Center"
    Width="100"
    Height="32"
    Margin="12,0,0,0"
    Style="{DynamicResource ButtonPill}"
    ToolTip="Cycle Scan / Apply"
  >
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="&#x27F3;" FontFamily="{DynamicResource FontSymbol}" FontSize="13"
                 Foreground="{DynamicResource BodyTextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
      <TextBlock x:Name="txtMode" Text="Scan" FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" VerticalAlignment="Center" />
    </StackPanel>
  </Button>

  <!-- Run all idle machines using the active mode (Scan / Apply Updates) -->
  <Button
    x:Name="btnRunAll"
    Grid.Column="2"
    Content="Run all"
    Style="{DynamicResource ButtonTintSuccess}"
    Width="100"
    Height="32"
    Margin="12,0,0,0"
  />
</Grid>

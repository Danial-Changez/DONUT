<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================ Action bar ============================ -->
<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Margin="0,0,0,16"
>
  <Grid.Resources>
    <!-- Converters must be in-file: they aren't DPs, so DynamicResource can't reach them. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>

  <!-- One input surface: the border carries the fill and focus ring so the icon and the
       transparent field read as a single control. Down and Up drive the finder dropdown. -->
  <Border
    x:Name="SearchBox"
    Grid.Column="0"
    BorderThickness="1"
    CornerRadius="8.4"
    Padding="12,0"
    Height="40"
  >
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputFill}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
            <Setter Property="Background" Value="{DynamicResource InputBorder}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="26" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Path
        Data="{DynamicResource Search}"
        Style="{DynamicResource lucideIcon}"
        Height="16"
        Width="16"
        StrokeThickness="1.33"
        Stroke="{DynamicResource BodyTextPrimary}"
        VerticalAlignment="Center"
        Grid.Column="0"
      />
      <TextBox
        x:Name="GoogleSearchBar"
        Style="{DynamicResource GoogleSearchBar}"
        Grid.Column="1"
        Margin="2,0,0,0"
        AcceptsReturn="False"
        TextWrapping="NoWrap"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Center"
        FontWeight="SemiBold"
      />
    </Grid>
  </Border>

  <!-- Live AD finder: computers to scan or run, users to unlock or reset. -->
  <Popup x:Name="SearchResultsPopup"
         Grid.Column="0"
         PlacementTarget="{Binding ElementName=SearchBox}"
         Placement="Bottom"
         AllowsTransparency="True"
         StaysOpen="True"
         PopupAnimation="Fade"
         Width="{Binding ActualWidth, ElementName=SearchBox}">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="0,4,0,0"
            Padding="6"
            SnapsToDevicePixels="True">
      <!-- Pixel scrolling: item scrolling leaves a dead band under the last row. -->
      <!-- Headers and result rows share one template, switched by IsHeader. A ListBox, not
           an ItemsControl, so Down and Up from the search bar can drive SelectedIndex. -->
      <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}"
               Background="Transparent" BorderThickness="0" MaxHeight="340"
               ItemContainerStyle="{DynamicResource MachineListItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="False">
        <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Text="{Binding HeaderText}" FontFamily="{DynamicResource FontSans}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource BodyTextTertiary}"
                           Margin="6,6,0,4">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <!-- Picking a row adds a computer to the machine pane, or opens a user's Lens. -->
                <Border CornerRadius="7" Padding="10,6,8,6" Margin="0,0,0,2">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                        </Trigger>
                        <!-- The selected row is what Enter will do, so it earns the violet tint. -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Border.InputBindings>
                    <!-- PickCommand is null on user rows, so the click is simply ignored. -->
                    <MouseBinding MouseAction="LeftClick" Command="{Binding PickCommand}" />
                  </Border.InputBindings>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Primary}" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                 Foreground="{DynamicResource TitleTextPrimary}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Primary}" />
                      <TextBlock Text="{Binding Secondary}" FontFamily="{DynamicResource FontSans}" FontSize="11"
                                 Foreground="{DynamicResource BodyTextTertiary}" Margin="0,1,0,0"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}" />
                    </StackPanel>
                    <!-- Grey stays neutral so Unlock keeps the row's one tint. -->
                    <Button Grid.Column="1" Content="Reset..." Command="{Binding ResetCommand}"
                            Style="{DynamicResource ButtonSecondary}" Height="32" FontSize="11"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTip="Set a temporary password"
                            Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />
                    <!-- The row's one action earns the tint, so Outline stays for low-emphasis nav. -->
                    <Button Grid.Column="2" Content="Unlock" Command="{Binding UnlockCommand}"
                            Style="{DynamicResource ButtonTintPrimary}" Height="32" FontSize="11"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Popup>

  <!-- The pill shows the active command, and clicking it switches to the other one. -->
  <Button
    x:Name="btnMode"
    Grid.Column="1"
    VerticalAlignment="Center"
    Width="100"
    Height="32"
    Margin="12,0,0,0"
    Style="{DynamicResource ButtonPill}"
    ToolTip="Switch between Scan and Apply"
  >
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="&#x27F3;" FontFamily="{DynamicResource FontSymbol}" FontSize="13"
                 Foreground="{DynamicResource BodyTextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
      <TextBlock x:Name="txtMode" Text="Scan" FontFamily="{DynamicResource FontSans}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextPrimary}" VerticalAlignment="Center" />
    </StackPanel>
  </Button>

  <!-- Runs every machine that is not already running, in the active mode. -->
  <Button
    x:Name="btnRunAll"
    Grid.Column="2"
    Content="Run All"
    Style="{DynamicResource ButtonTintSuccess}"
    Width="100"
    Height="32"
    Margin="12,0,0,0"
  />
</Grid>

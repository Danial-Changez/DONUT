<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="DONUT"
        Height="700"
        Width="1300"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource PrimaryBackground}"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Main window border and content -->
        <Border CornerRadius="0"
                BorderThickness="1"
                Background="Transparent"
                x:Name="rootBorder">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="{DynamicResource WindowBorderPrimaryColor}"
                                  Offset="0" />
                    <GradientStop Color="{DynamicResource WindowBorderAccentColor}"
                                  Offset="0" />
                    <GradientStop Color="{DynamicResource WindowBorderSecondaryColor}"
                                  Offset="0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <!-- Main Section -->
                <Border CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0.75">
                            <GradientStop Color="{DynamicResource PrimaryBackgroundDarkColor}"
                                          Offset="0" />
                            <GradientStop Color="{DynamicResource PrimaryBackgroundColor}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Control Bar -->
                            <RowDefinition Height="30" />
                            <!-- Branding bar -->
                            <RowDefinition Height="48" />
                            <!-- Content Section / Child Views -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Control Bar -->
                        <StackPanel x:Name="panelControlBar"
                                    Grid.Row="0"
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft"
                                    Background="Transparent">
                            <Button x:Name="btnClose"
                                    Command="{Binding CloseCommand}"
                                    Style="{DynamicResource controlButton}"
                                    Tag="{DynamicResource Destructive}">
                                <Path Style="{DynamicResource controlButtonIcon}"
                                      Data="{DynamicResource xMark}" />
                            </Button>
                            <Button x:Name="btnMaximize"
                                    Command="{Binding MaximizeCommand}"
                                    Style="{DynamicResource controlButton}"
                                    Tag="{DynamicResource AccentYellow}">
                                <Path Style="{DynamicResource controlButtonIcon}"
                                      Data="{DynamicResource Square}" />
                            </Button>
                            <Button x:Name="btnMinimize"
                                    Command="{Binding MinimizeCommand}"
                                    Style="{DynamicResource controlButton}"
                                    Tag="{DynamicResource AccentBlueLight}">
                                <Path Style="{DynamicResource controlButtonIcon}"
                                      Width="13"
                                      Data="{DynamicResource Minimize}" />
                            </Button>
                            <!-- Help replays the guided tour. -->
                            <Button x:Name="btnHelp"
                                    Command="{Binding OpenTourCommand}"
                                    Style="{DynamicResource controlButton}"
                                    Tag="{DynamicResource Primary}"
                                    ToolTip="Take a quick tour">
                                <Path Style="{DynamicResource controlButtonIcon}"
                                      Width="14"
                                      Height="14"
                                      Data="{DynamicResource Help}" />
                            </Button>
                            <!-- Gear opens the settings overlay (the only config entry point). -->
                            <Button x:Name="btnSettings"
                                    Command="{Binding OpenSettingsCommand}"
                                    Style="{DynamicResource controlButton}"
                                    Tag="{DynamicResource Primary}"
                                    ToolTip="Settings">
                                <Path Style="{DynamicResource controlButtonIcon}"
                                      Width="14"
                                      Height="14"
                                      Data="{DynamicResource Config}" />
                            </Button>
                        </StackPanel>
                        <!-- Branding bar: the DONUT wordmark (Logo source set in
                             MainPresenter.LoadImages). -->
                        <Image x:Name="Logo"
                               Grid.Row="1"
                               Height="32"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="35,0,0,0" />
                        <ContentControl x:Name="contentMain"
                                        Grid.Row="2"
                                        Margin="25" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Settings overlay: non-modal dim + centered card hosting ConfigView. Not a
             ShowDialog, so background scans keep pumping behind it. -->
        <Grid x:Name="settingsOverlay"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
            </Grid.InputBindings>
            <!-- Dim backdrop, a sibling BEHIND the card so card clicks don't bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="settingsCard"
                    Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Focusable="True"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Header: the title and close sit on one row, pinned above the scroll. -->
                    <Grid Grid.Row="0"
                          Margin="20,14,12,0">
                        <TextBlock Text="Configuration"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TitleTextPrimary}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                        <Button HorizontalAlignment="Right"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{DynamicResource controlButton}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Width="12"
                                  Height="12"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="20,12,20,20">
                        <ContentControl x:Name="settingsContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- QR overlay: same non-modal dim + centered card as settings, showing a QR of a
             BitLocker recovery key. The image is built in memory (never written to disk). -->
        <Grid x:Name="qrOverlay"
              Visibility="{Binding IsQrOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseQrCommand}" />
            </Grid.InputBindings>
            <!-- Dim backdrop, a sibling BEHIND the card so card clicks don't bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseQrCommand}" />
                </Border.InputBindings>
            </Border>
            <Border Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Focusable="True"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1">
                <Grid Margin="20,14,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Header: caption + close, mirroring the settings card. -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding QrCaption}"
                                   FontFamily="{DynamicResource FontSans}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TitleTextPrimary}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,40,0" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseQrCommand}"
                                Style="{DynamicResource controlButton}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Width="12"
                                  Height="12"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <!-- Light "code chip": a QR must stay dark-on-light to scan, so the plate
                         stays light but is tinted to violet-50 (matching the QR's own light
                         colour, no seam) and framed in the theme's violet to sit deliberately
                         inside the dark card. -->
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource QrPlate}"
                            BorderBrush="{DynamicResource WindowBorderAccent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               Text="Scan to read the recovery key, then close this."
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BodyTextTertiary}" />
                </Grid>
            </Border>
        </Grid>
        <!-- Guided-tour overlay: four dim panels frame a spotlight hole over the current
             target, with a callout card. TourPresenter positions everything per step; the
             backdrop is inert (no accidental dismiss) - Esc / Skip exit. -->
        <Grid x:Name="tourOverlay"
              Visibility="{Binding IsTourOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseTourCommand}" />
            </Grid.InputBindings>
            <Border x:Name="tourDimFull" Background="{DynamicResource DimBackdrop}" Visibility="Collapsed" />
            <Border x:Name="tourDimTop" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimBottom" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimLeft" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Left" Width="0" Height="0" />
            <Border x:Name="tourDimRight" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Width="0" Height="0" />
            <Border x:Name="tourSpotlight" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Width="0" Height="0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="10" />
            <Border x:Name="tourCallout" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="16,16,16,14">
                <StackPanel>
                    <TextBlock x:Name="tourStepLabel" Text="Step 1 of 5"
                               FontFamily="{DynamicResource FontSans}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPurpleLight}" Margin="0,0,0,6" />
                    <TextBlock x:Name="tourTitle" Text="Welcome"
                               FontFamily="{DynamicResource FontSans}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TitleTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="tourBody" Text=""
                               FontFamily="{DynamicResource FontSans}" FontSize="13.5"
                               Foreground="{DynamicResource BodyTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid>
                        <!-- Progress dots (built by TourPresenter) fill the left; actions on the right. -->
                        <StackPanel x:Name="tourDots" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnTourSkip" Content="Skip tour" Style="{DynamicResource ButtonGhost}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourBack" Content="Back" Style="{DynamicResource ButtonOutline}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourNext" Content="Next" Style="{DynamicResource ButtonTintPrimary}"
                                    FontSize="12.5" Height="32" MinWidth="72" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Toast overlay: non-modal notifications stack here, top-right, above
             everything else. The host itself is click-through; only the toast
             cards inside it are hit-testable. -->
        <ItemsControl x:Name="toastHost"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,44,18,0"
                      Width="340"
                      Background="Transparent"
                      IsHitTestVisible="True">
            <!-- One card per ToastViewModel: accent border/bar/title/glow, optional
                 message, click to dismiss. Slide+fade in on load; the IsClosing
                 DataTrigger plays the exit before ToastService removes the item. -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="card"
                            BorderBrush="{Binding Accent}" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,10" Cursor="Hand"
                            Opacity="0">
                        <Border.Background>
                            <!-- Arcane surface (#171717) at ~92%, matching the glass toast -->
                            <SolidColorBrush Color="{DynamicResource SurfaceSolidColor}"
                                             Opacity="0.92" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="slide" X="40" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"
                                              Color="{Binding AccentColor}" />
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="10,0,0,10" />
                            <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}"
                                           FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TitleTextTertiary}"
                                           FontFamily="{DynamicResource FontSans}" FontSize="12.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="card">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="card"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="slide"
                                                     Storyboard.TargetProperty="X"
                                                     From="40" To="0" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="slide"
                                                         Storyboard.TargetProperty="X"
                                                         To="40" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
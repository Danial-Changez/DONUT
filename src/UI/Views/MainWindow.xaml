<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="DONUT"
        Height="700"
        Width="1300"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource PrimaryBackground}"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Main window border and content -->
        <Border CornerRadius="0"
                BorderThickness="1"
                Background="Transparent"
                BorderBrush="{DynamicResource PanelBorder}"
                x:Name="rootBorder">
            <Grid>
                <!-- Main Section -->
                <Border CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0.75">
                            <GradientStop Color="{DynamicResource PrimaryBackgroundDarkColor}"
                                          Offset="0" />
                            <GradientStop Color="{DynamicResource PrimaryBackgroundColor}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Control Bar: logo + window controls (50x36 buttons) -->
                            <RowDefinition Height="36" />
                            <!-- Content Section / Child Views -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Control Bar: transparent background keeps it the DragMove surface.
                             Buttons dock right (RTL packs them to the edge); logo fills the rest. -->
                        <DockPanel x:Name="panelControlBar"
                                   Grid.Row="0"
                                   Background="Transparent"
                                   LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        FlowDirection="RightToLeft">
                                <Button x:Name="btnClose"
                                        Command="{Binding CloseCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource Destructive}"
                                        ToolTip="Close">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Data="{DynamicResource xMark}" />
                                </Button>
                                <Button x:Name="btnMaximize"
                                        Command="{Binding MaximizeCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource AccentYellow}"
                                        ToolTip="Maximize / restore">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Data="{DynamicResource Square}" />
                                </Button>
                                <Button x:Name="btnMinimize"
                                        Command="{Binding MinimizeCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource AccentBlueLight}"
                                        ToolTip="Minimize">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Width="13"
                                          Data="{DynamicResource Minimize}" />
                                </Button>
                                <!-- Docs opens the online documentation in the default browser. -->
                                <Button x:Name="btnDocs"
                                        Command="{Binding OpenDocsCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource Primary}"
                                        ToolTip="Open the documentation">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Width="14"
                                          Height="14"
                                          Data="{DynamicResource File}" />
                                </Button>
                                <!-- Help replays the guided tour. -->
                                <Button x:Name="btnHelp"
                                        Command="{Binding OpenTourCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource Primary}"
                                        ToolTip="Take a quick tour">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Width="14"
                                          Height="14"
                                          Data="{DynamicResource Help}" />
                                </Button>
                                <!-- Gear opens the settings overlay (the only config entry point). -->
                                <Button x:Name="btnSettings"
                                        Command="{Binding OpenSettingsCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource Primary}"
                                        ToolTip="Settings">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Width="14"
                                          Height="14"
                                          Data="{DynamicResource Config}" />
                                </Button>
                            </StackPanel>
                            <!-- The DONUT wordmark (source set in MainPresenter.LoadImages).
                                 Left inset matches contentMain's 25 so the logo sits on the
                                 same column as the search bar; 20px tall so it breathes in
                                 the 36px bar. Hit-test off for DragMove. -->
                            <Image x:Name="Logo"
                                   Height="20"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="25,0,0,0"
                                   IsHitTestVisible="False" />
                        </DockPanel>
                        <ContentControl x:Name="contentMain"
                                        Grid.Row="1"
                                        Margin="25" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Settings overlay: non-modal dim + centered card hosting ConfigView. Not a
             ShowDialog, so background scans keep pumping behind it. -->
        <Grid x:Name="settingsOverlay"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
            </Grid.InputBindings>
            <!-- Dim backdrop, a sibling BEHIND the card so card clicks don't bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="settingsCard"
                    Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Focusable="True"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Header: the title and close sit on one row, pinned above the scroll. -->
                    <Grid Grid.Row="0"
                          Margin="20,14,12,0">
                        <TextBlock Text="Settings"
                                   Style="{DynamicResource TextPaneTitle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                        <!-- Same footprint as the title-bar close (50x36) so hover reads alike. -->
                        <Button HorizontalAlignment="Right"
                                Height="36"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{DynamicResource controlButton}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="20,12,20,20">
                        <ContentControl x:Name="settingsContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- Reset-password overlay: same non-modal dim + centered card idiom. Sits BEFORE
             qrOverlay so the password QR pops on top of this card, like BitLocker's. -->
        <Grid x:Name="resetOverlay"
              Visibility="{Binding IsResetOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseResetCommand}" />
            </Grid.InputBindings>
            <!-- Dim backdrop, a sibling BEHIND the card so card clicks don't bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseResetCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="resetCard"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Focusable="True"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1">
                <!-- Modal anatomy on the DialogWindow recipe: full-bleed close bar whose
                     title names the target, UPN/SAM tiles side by side (the person-fields
                     MicroLabel idiom), field + icon utilities, checkbox, then a footer
                     pairing Generate with the destructive primary. 24px content gutters. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Close bar (DialogWindow idiom): full-bleed 36px row holding only the
                         X, flush in the corner - the title sits BELOW the bar so it clears
                         the card's top edge instead of hugging it. -->
                    <Grid Grid.Row="0"
                          Height="36">
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseResetCommand}"
                                Style="{DynamicResource controlButtonCardClose}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Style="{DynamicResource TextPaneTitle}"
                               HorizontalAlignment="Left"
                               Margin="24,2,24,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ResetVm.DisplayName}"><Run Text="Reset password " /><Run Text="{Binding ResetVm.DisplayName, Mode=OneWay, StringFormat='({0})'}"
                             FontWeight="Normal"
                             Foreground="{DynamicResource TitleTextTertiary}" /></TextBlock>
                    <!-- Target identifiers: UPN and SAM side by side on the shared Card
                         recipe (same scheme as the home stat cards), each the
                         person-fields pairing - MicroLabel grey over a brighter value. -->
                    <Grid Grid.Row="2"
                          Margin="24,12,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{DynamicResource Card}"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="UPN"
                                           Style="{DynamicResource MicroLabel}" />
                                <TextBox Style="{DynamicResource SelectableText}"
                                         Text="{Binding ResetVm.TargetUpn, Mode=OneWay}"
                                         ToolTip="{Binding ResetVm.TargetUpn}"
                                         FontFamily="{DynamicResource FontMono}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TitleTextPrimary}"
                                         Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{DynamicResource Card}"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="SAM"
                                           Style="{DynamicResource MicroLabel}" />
                                <TextBox Style="{DynamicResource SelectableText}"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                         FontFamily="{DynamicResource FontMono}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TitleTextPrimary}"
                                         Margin="0,3,0,0">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0} @ {1}"
                                                      Mode="OneWay">
                                            <Binding Path="ResetVm.TargetSam"
                                                     Mode="OneWay" />
                                            <Binding Path="ResetVm.TargetDomain"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Temp password: the field with Copy/QR icon utilities beside it -
                         they wake once a password exists (Progressive Disclosure,
                         mirroring the BitLocker reveal). -->
                    <StackPanel Grid.Row="3"
                                Margin="24,16,24,0">
                        <TextBlock Text="TEMPORARY PASSWORD"
                                   Style="{DynamicResource MicroLabel}"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="resetPasswordBox"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource FontMono}"
                                         Margin="0"
                                         Text="{Binding ResetVm.Password, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Type a password, or generate one below"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="11,0,0,0"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource BodyTextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=resetPasswordBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- Wrapped so the enable gate doesn't restyle the themed buttons
                                 (runtime DynamicResource styles can't take BasedOn);
                                 tooltips stay on while disabled to explain the gate. -->
                            <ContentControl Grid.Column="1"
                                            Margin="6,0,0,0"
                                            ToolTipService.ShowOnDisabled="True">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=resetPasswordBox}" Value="">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <Button Command="{Binding ResetVm.CopyCommand}"
                                        Style="{DynamicResource ButtonSecondary}"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        ToolTip="Copy the temporary password">
                                    <Path Data="{DynamicResource Copy}"
                                          Fill="{DynamicResource SecondaryForeground}"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform" />
                                </Button>
                            </ContentControl>
                            <ContentControl Grid.Column="2"
                                            Margin="6,0,0,0"
                                            ToolTipService.ShowOnDisabled="True">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=resetPasswordBox}" Value="">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <Button Command="{Binding ResetVm.ShowQrCommand}"
                                        Style="{DynamicResource ButtonSecondary}"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        ToolTip="Show a QR code of the temporary password">
                                    <Path Data="{DynamicResource QrCode}"
                                          Fill="{DynamicResource SecondaryForeground}"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform" />
                                </Button>
                            </ContentControl>
                        </Grid>
                    </StackPanel>
                    <!-- Good Defaults: a temp password should force a change at next logon. -->
                    <CheckBox Grid.Row="4"
                              Style="{DynamicResource ModernCheckBox}"
                              IsChecked="{Binding ResetVm.ChangeAtLogon, Mode=TwoWay}"
                              Margin="24,16,24,0"
                              Content="Require password change at next logon" />
                    <!-- Footer pairs the flow: Generate on the left feeds the destructive
                         primary on the right. X / Esc / backdrop close the card. -->
                    <Grid Grid.Row="5"
                          Margin="24,20,24,20">
                        <Button Content="Generate"
                                Command="{Binding ResetVm.GenerateCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                HorizontalAlignment="Left"
                                Height="36"
                                MinWidth="96"
                                ToolTip="Generate a strong phone-readable password" />
                        <Button Content="Reset password"
                                Command="{Binding ResetVm.ApplyCommand}"
                                Style="{DynamicResource ButtonTintDestructive}"
                                HorizontalAlignment="Right"
                                Height="36"
                                MinWidth="120" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- QR overlay: same non-modal dim + centered card as settings, showing a QR of a
             BitLocker recovery key. The image is built in memory (never written to disk). -->
        <Grid x:Name="qrOverlay"
              Visibility="{Binding IsQrOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseQrCommand}" />
            </Grid.InputBindings>
            <!-- Dim backdrop, a sibling BEHIND the card so card clicks don't bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseQrCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="qrCard"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Focusable="True"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1">
                <Grid Margin="20,14,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Header: caption + close, mirroring the settings card. -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding QrCaption}"
                                   Style="{DynamicResource TextSubtitle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,40,0" />
                        <!-- Same footprint as the title-bar close (50x36) so hover reads alike. -->
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Height="36"
                                Command="{Binding CloseQrCommand}"
                                Style="{DynamicResource controlButton}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <!-- Inverted themed QR (violet-300 modules, transparent back) blending
                         straight into the card - no plate. The 12px inset is the quiet zone. -->
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="12"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <!-- Hint varies with the payload (recovery key vs temp password);
                         MainPresenter.ShowQr sets it alongside the caption. -->
                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               Text="{Binding QrHint}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BodyTextTertiary}" />
                </Grid>
            </Border>
        </Grid>
        <!-- Guided-tour overlay: four dim panels frame a spotlight hole over the current
             target, with a callout card. TourPresenter positions everything per step; the
             backdrop is inert (no accidental dismiss) - Esc / Skip exit. -->
        <Grid x:Name="tourOverlay"
              Visibility="{Binding IsTourOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseTourCommand}" />
            </Grid.InputBindings>
            <Border x:Name="tourDimFull" Background="{DynamicResource DimBackdrop}" Visibility="Collapsed" />
            <Border x:Name="tourDimTop" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimBottom" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimLeft" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Left" Width="0" Height="0" />
            <Border x:Name="tourDimRight" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Width="0" Height="0" />
            <Border x:Name="tourSpotlight" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Width="0" Height="0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="10" />
            <Border x:Name="tourCallout" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Focusable="True"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="tourTitle" Text="Welcome"
                               Style="{DynamicResource TextTitle}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="tourBody" Text=""
                               FontFamily="{DynamicResource FontSans}" FontSize="13.5"
                               Foreground="{DynamicResource BodyTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid>
                        <!-- Progress dots (built by TourPresenter) fill the left; actions on the right. -->
                        <StackPanel x:Name="tourDots" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnTourSkip" Content="Skip tour" Style="{DynamicResource ButtonGhost}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourBack" Content="Back" Style="{DynamicResource ButtonOutline}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourNext" Content="Next" Style="{DynamicResource ButtonTintPrimary}"
                                    FontSize="12.5" Height="32" MinWidth="72" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Toast overlay: non-modal notifications stack here, top-right, above
             everything else. The host itself is click-through; only the toast
             cards inside it are hit-testable. -->
        <ItemsControl x:Name="toastHost"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,44,18,0"
                      Width="340"
                      Background="Transparent"
                      IsHitTestVisible="True">
            <!-- One card per ToastViewModel: accent border/bar/title/glow, optional
                 message, click to dismiss. Slide+fade in on load; the IsClosing
                 DataTrigger plays the exit before ToastService removes the item. -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="card"
                            BorderBrush="{Binding Accent}" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,10" Cursor="Hand"
                            Opacity="0">
                        <Border.Background>
                            <!-- Arcane surface (#171717) at ~92%, matching the glass toast -->
                            <SolidColorBrush Color="{DynamicResource SurfaceSolidColor}"
                                             Opacity="0.92" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="slide" X="40" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"
                                              Color="{Binding AccentColor}" />
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="10,0,0,10" />
                            <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}"
                                           FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TitleTextTertiary}"
                                           FontFamily="{DynamicResource FontSans}" FontSize="12.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="card">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="card"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="slide"
                                                     Storyboard.TargetProperty="X"
                                                     From="40" To="0" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="slide"
                                                         Storyboard.TargetProperty="X"
                                                         To="40" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="DONUT"
        Height="700"
        Width="1300"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource PrimaryBackground}"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Border CornerRadius="0"
                BorderThickness="1"
                Background="Transparent"
                BorderBrush="{DynamicResource PanelBorder}">
            <Grid>
                <Border CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0.75">
                            <GradientStop Color="{DynamicResource PrimaryBackgroundDarkColor}"
                                          Offset="0" />
                            <GradientStop Color="{DynamicResource PrimaryBackgroundColor}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Transparent background keeps the whole bar the DragMove surface, and
                             the button stack flows RTL so it packs against the right edge. -->
                        <DockPanel x:Name="panelControlBar"
                                   Grid.Row="0"
                                   Background="Transparent"
                                   LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        FlowDirection="RightToLeft">
                                <Button x:Name="btnClose"
                                        Command="{Binding CloseCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource Destructive}"
                                        ToolTip="Close">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Data="{DynamicResource xMark}" />
                                </Button>
                                <Button Command="{Binding MaximizeCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource AccentYellow}"
                                        ToolTip="Maximize / restore">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Data="{DynamicResource Square}" />
                                </Button>
                                <Button x:Name="btnMinimize"
                                        Command="{Binding MinimizeCommand}"
                                        Style="{DynamicResource controlButton}"
                                        Tag="{DynamicResource AccentBlueLight}"
                                        ToolTip="Minimize">
                                    <Path Style="{DynamicResource controlButtonIcon}"
                                          Width="13"
                                          StrokeThickness="1.08"
                                          Data="{DynamicResource Minimize}" />
                                </Button>
                                <!-- Named and pinned LTR for the tour:
                                     - The name lets the last step spotlight all three at once.
                                     - LTR keeps the spotlight transform off the top-right corner.
                                     - Children are pre-reversed to match the RTL siblings' order. -->
                                <StackPanel x:Name="panelHelpButtons"
                                            Orientation="Horizontal"
                                            FlowDirection="LeftToRight">
                                    <Button Command="{Binding OpenSettingsCommand}"
                                            Style="{DynamicResource controlButton}"
                                            Tag="{DynamicResource Primary}"
                                            ToolTip="Settings">
                                        <Path Style="{DynamicResource controlButtonIcon}"
                                              Width="14"
                                              Height="14"
                                              StrokeThickness="1.17"
                                              Data="{DynamicResource Config}" />
                                    </Button>
                                    <Button Command="{Binding OpenTourCommand}"
                                            Style="{DynamicResource controlButton}"
                                            Tag="{DynamicResource Primary}"
                                            ToolTip="Take a tour">
                                        <Path Style="{DynamicResource controlButtonIcon}"
                                              Width="14"
                                              Height="14"
                                              StrokeThickness="1.17"
                                              Data="{DynamicResource Help}" />
                                    </Button>
                                    <Button Command="{Binding OpenDocsCommand}"
                                            Style="{DynamicResource controlButton}"
                                            Tag="{DynamicResource Primary}"
                                            ToolTip="Documentation">
                                        <Path Style="{DynamicResource controlButtonIcon}"
                                              Width="14"
                                              Height="14"
                                              StrokeThickness="1.17"
                                              Data="{DynamicResource File}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- MainPresenter.LoadImages sets the source. The 25 inset aligns
                                     it with contentMain, and hit-testing off keeps DragMove. -->
                                <Image x:Name="Logo"
                                       Height="20"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="25,0,0,0"
                                       IsHitTestVisible="False" />
                                <!-- De-elevated is a state you carry all session, so it gets a
                                     standing badge, not just the toast that announced it. -->
                                <Border x:Name="badgeLimited"
                                        Style="{DynamicResource BadgeAmber}"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock Text="LIMITED"
                                               Style="{DynamicResource BadgeAmberText}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <!-- The build is a fact you carry all session, like LIMITED.
                                     Clicking copies it, since reporting one is why it is here. -->
                                <Button x:Name="btnVersion"
                                        Command="{Binding CopyVersionCommand}"
                                        Style="{DynamicResource ButtonBadge}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        ToolTip="Copy the version"
                                        Visibility="{Binding HasAppVersion, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AppVersion}"
                                               FontFamily="{DynamicResource FontMono}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BodyTextPrimary}"
                                               VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <ContentControl x:Name="contentMain"
                                        Grid.Row="1"
                                        Margin="25" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Not a ShowDialog, so background scans keep pumping behind the settings card. -->
        <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
            </Grid.InputBindings>
            <!-- A sibling behind the card, so clicks on the card do not bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="settingsCard"
                    Style="{DynamicResource OverlayCard}"
                    Width="560"
                    MaxHeight="640">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Popup chrome contract: 48px header, X flush in the card corner. -->
                    <Grid Grid.Row="0"
                          Height="48">
                        <TextBlock Text="Settings"
                                   Style="{DynamicResource TextPaneTitle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="24,0,56,0" />
                        <!-- In the header, not the scrolling body, so it stays reachable at any
                             scroll depth, and centered because the title and X own the edges. -->
                        <Border CornerRadius="8.4"
                                Background="{DynamicResource Secondary}"
                                Padding="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="cmdGeneral"
                                             Content="General"
                                             GroupName="cmd"
                                             Style="{DynamicResource SegmentToggle}" />
                                <RadioButton x:Name="cmdScan"
                                             Content="Scan"
                                             GroupName="cmd"
                                             Style="{DynamicResource SegmentToggle}" />
                                <RadioButton x:Name="cmdApplyUpdates"
                                             Content="Apply"
                                             GroupName="cmd"
                                             Style="{DynamicResource SegmentToggle}" />
                            </UniformGrid>
                        </Border>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{DynamicResource controlButtonCardClose}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="24,8,24,20">
                        <ContentControl x:Name="settingsContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- Declared before qrOverlay so the password QR pops on top of this card. -->
        <Grid Visibility="{Binding IsResetOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseResetCommand}" />
            </Grid.InputBindings>
            <!-- A sibling behind the card, so clicks on the card do not bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseResetCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="resetCard"
                    Style="{DynamicResource OverlayCard}"
                    Width="440">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Popup chrome contract: 48px header, X flush in the card corner. -->
                    <Grid Grid.Row="0"
                          Height="48">
                        <TextBlock Style="{DynamicResource TextPaneTitle}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="24,0,56,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ResetVm.DisplayName}"><Run Text="Reset Password " /><Run Text="{Binding ResetVm.DisplayName, Mode=OneWay, StringFormat='({0})'}"
                                 FontWeight="Normal"
                                 Foreground="{DynamicResource TitleTextTertiary}" /></TextBlock>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseResetCommand}"
                                Style="{DynamicResource controlButtonCardClose}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1"
                          Margin="24,6,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{DynamicResource Card}"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="UPN"
                                           Style="{DynamicResource MicroLabel}" />
                                <TextBox Style="{DynamicResource CopyableValue}"
                                         Text="{Binding ResetVm.TargetUpn, Mode=OneWay}"
                                         Tag="{Binding ResetVm.TargetUpn}"
                                         FontFamily="{DynamicResource FontMono}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TitleTextPrimary}"
                                         Margin="-4,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{DynamicResource Card}"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="SAM"
                                           Style="{DynamicResource MicroLabel}" />
                                <TextBox Style="{DynamicResource CopyableValue}"
                                         Text="{Binding ResetVm.TargetSam, Mode=OneWay}"
                                         Tag="{Binding ResetVm.TargetSam}"
                                         FontFamily="{DynamicResource FontMono}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TitleTextPrimary}"
                                         Margin="-4,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Progressive Disclosure: Copy and QR wake only once a password exists. -->
                    <StackPanel Grid.Row="2"
                                Margin="24,16,24,0">
                        <TextBlock Text="TEMPORARY PASSWORD"
                                   Style="{DynamicResource MicroLabel}"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="resetPasswordBox"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource FontMono}"
                                         Margin="0"
                                         Text="{Binding ResetVm.Password, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- Clears on focus, not just on text, because the watermark is
                                     a sibling overlay the caret would otherwise sit inside. -->
                                <TextBlock Text="Type or generate a password"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="11,0,0,0"
                                           FontFamily="{DynamicResource FontSans}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource BodyTextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=resetPasswordBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocused, ElementName=resetPasswordBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- Wrapped so the enable gate cannot restyle the themed button,
                                 since runtime DynamicResource styles take no BasedOn. -->
                            <ContentControl Grid.Column="1"
                                            Margin="6,0,0,0"
                                            ToolTipService.ShowOnDisabled="True">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=resetPasswordBox}" Value="">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <Button Command="{Binding ResetVm.CopyCommand}"
                                        Style="{DynamicResource ButtonSecondary}"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        ToolTip="Copy password">
                                    <Path Data="{DynamicResource Copy}"
                                          Style="{DynamicResource lucideIcon}"
                                          Stroke="{DynamicResource SecondaryForeground}"
                                          Width="13"
                                          Height="13"
                                          StrokeThickness="1.08" />
                                </Button>
                            </ContentControl>
                            <ContentControl Grid.Column="2"
                                            Margin="6,0,0,0"
                                            ToolTipService.ShowOnDisabled="True">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=resetPasswordBox}" Value="">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <Button Command="{Binding ResetVm.ShowQrCommand}"
                                        Style="{DynamicResource ButtonSecondary}"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        ToolTip="Show QR code">
                                    <Path Data="{DynamicResource QrCode}"
                                          Style="{DynamicResource lucideIcon}"
                                          Stroke="{DynamicResource SecondaryForeground}"
                                          Width="14"
                                          Height="14"
                                          StrokeThickness="1.17" />
                                </Button>
                            </ContentControl>
                        </Grid>
                    </StackPanel>
                    <!-- Good Defaults: a temp password should force a change at next logon. -->
                    <CheckBox Grid.Row="3"
                              Style="{DynamicResource ModernCheckBox}"
                              IsChecked="{Binding ResetVm.ChangeAtLogon, Mode=TwoWay}"
                              Margin="24,16,24,0"
                              Content="Require Password Change at Next Logon" />
                    <!-- No Close button: X, Esc, and the backdrop already dismiss the card. -->
                    <Grid Grid.Row="4"
                          Margin="24,20,24,20">
                        <Button Content="Generate"
                                Command="{Binding ResetVm.GenerateCommand}"
                                Style="{DynamicResource ButtonSecondary}"
                                HorizontalAlignment="Left"
                                Height="36"
                                MinWidth="96"
                                ToolTip="Generates a phone-readable password" />
                        <Button Content="Reset Password"
                                Command="{Binding ResetVm.ApplyCommand}"
                                Style="{DynamicResource ButtonTintDestructive}"
                                HorizontalAlignment="Right"
                                Height="36"
                                MinWidth="120" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- The QR image is built in memory and never written to disk. -->
        <Grid x:Name="qrOverlay"
              Visibility="{Binding IsQrOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseQrCommand}" />
            </Grid.InputBindings>
            <!-- A sibling behind the card, so clicks on the card do not bubble here. -->
            <Border Background="{DynamicResource DimBackdrop}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseQrCommand}" />
                </Border.InputBindings>
            </Border>
            <Border x:Name="qrCard"
                    Style="{DynamicResource OverlayCard}"
                    Width="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- MinHeight lets a wrapped caption grow the row without moving the X. -->
                    <Grid Grid.Row="0"
                          MinHeight="48">
                        <TextBlock Text="{Binding QrCaption}"
                                   Style="{DynamicResource TextSubtitle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="24,10,56,10" />
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseQrCommand}"
                                Style="{DynamicResource controlButtonCardClose}"
                                Tag="{DynamicResource Destructive}"
                                ToolTip="Close">
                            <Path Style="{DynamicResource controlButtonIcon}"
                                  Data="{DynamicResource xMark}" />
                        </Button>
                    </Grid>
                    <!-- Inverted by choice, and the 12px padding is the QR quiet zone. -->
                    <Border Grid.Row="1"
                            Margin="24,4,24,0"
                            Padding="12"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <!-- MainPresenter.ShowQr varies the hint by payload. -->
                    <TextBlock Grid.Row="2"
                               Margin="24,12,24,20"
                               Text="{Binding QrHint}"
                               FontFamily="{DynamicResource FontSans}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BodyTextTertiary}" />
                </Grid>
            </Border>
        </Grid>
        <!-- TourPresenter positions the panels and callout per step. The backdrop is inert
             so a stray click cannot drop someone out of the tour. -->
        <Grid x:Name="tourOverlay"
              Visibility="{Binding IsTourOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseTourCommand}" />
            </Grid.InputBindings>
            <Border x:Name="tourDimFull" Background="{DynamicResource DimBackdrop}" Visibility="Collapsed" />
            <Border x:Name="tourDimTop" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimBottom" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="0" />
            <Border x:Name="tourDimLeft" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Left" Width="0" Height="0" />
            <Border x:Name="tourDimRight" Background="{DynamicResource DimBackdrop}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" Width="0" Height="0" />
            <Border x:Name="tourSpotlight" HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Width="0" Height="0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="10" />
            <Border x:Name="tourCallout" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Focusable="True"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="tourTitle" Text="Welcome"
                               Style="{DynamicResource TextTitle}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="tourBody" Text=""
                               FontFamily="{DynamicResource FontSans}" FontSize="13.5"
                               Foreground="{DynamicResource BodyTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Grid>
                        <!-- TourPresenter fills the dots at runtime. -->
                        <StackPanel x:Name="tourDots" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnTourSkip" Content="Skip Tour" Style="{DynamicResource ButtonGhost}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourBack" Content="Back" Style="{DynamicResource ButtonOutline}"
                                    FontSize="12.5" Height="32" Margin="0,0,8,0" />
                            <Button x:Name="btnTourNext" Content="Next" Style="{DynamicResource ButtonTintPrimary}"
                                    FontSize="12.5" Height="32" MinWidth="72" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Declared last so toasts stack above every other layer. -->
        <ItemsControl x:Name="toastHost"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,44,18,0"
                      Width="340"
                      Background="Transparent"
                      IsHitTestVisible="True">
            <!-- ToastService flips IsClosing first so the exit animation can play
                 before the item is removed. -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="card"
                            BorderBrush="{Binding Accent}" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,0,10" Cursor="Hand"
                            Opacity="0">
                        <Border.Background>
                            <!-- Arcane surface at 92% opacity gives the glass toast look. -->
                            <SolidColorBrush Color="{DynamicResource SurfaceSolidColor}"
                                             Opacity="0.92" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="slide" X="40" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"
                                              Color="{Binding AccentColor}" />
                        </Border.Effect>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="10,0,0,10" />
                            <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}"
                                           FontFamily="{DynamicResource FontSans}" FontWeight="SemiBold" FontSize="14"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TitleTextTertiary}"
                                           FontFamily="{DynamicResource FontSans}" FontSize="12.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="card">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="card"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="slide"
                                                     Storyboard.TargetProperty="X"
                                                     From="40" To="0" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <DataTrigger Binding="{Binding IsClosing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="slide"
                                                         Storyboard.TargetProperty="X"
                                                         To="40" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
<!-- Scan option form. The x:Names are the dcu-cli arg keys the SettingsPresenter binder
     reads and writes, and the shared chip card loads into updateOptionsSlot. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Flags"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <ToggleButton x:Name="silent"
                          Content="Silent"
                          Style="{DynamicResource ModernToggleSwitch}" />
        </StackPanel>
    </Border>
    <!-- SettingsPresenter fills this with the shared UpdateOptionsView. -->
    <ContentControl x:Name="updateOptionsSlot"
                    Margin="0,0,0,12"
                    Focusable="False"
                    IsTabStop="False" />
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="Text Options"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Output Log"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="outputLog"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Catalog Location"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="catalogLocation"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Report"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="report"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

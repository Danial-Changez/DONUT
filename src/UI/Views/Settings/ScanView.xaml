<!-- Scan option form: Arcane sub-cards. Control x:Names are the dcu-cli arg keys
     the ConfigPresenter binder reads/writes; multi-select chips keep their Content. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flags -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="FLAGS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="silent"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Silent"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Update options (multi-select chips) -->
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="UPDATE OPTIONS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Severity"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateSeverity">
                    <CheckBox Content="Security" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Critical" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Recommended" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Optional" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Type"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateType">
                    <CheckBox Content="Bios" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Firmware" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Driver" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Application" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Others" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Device category"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,8" />
                <WrapPanel x:Name="updateDeviceCategory">
                    <CheckBox Content="Audio" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Video" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Network" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Storage" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Input" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Chipset" Style="{DynamicResource ChipCheckBox}" />
                    <CheckBox Content="Others" Style="{DynamicResource ChipCheckBox}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Text options -->
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="TEXT OPTIONS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Output log"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="outputLog"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Catalog location"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="catalogLocation"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Report"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="report"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

<!-- General settings form. The x:Names are read and written by SettingsPresenter's
     General section binder, and are app options rather than dcu-cli args. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="STARTUP &amp; TRAY"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">
                <ToggleButton x:Name="chkStartWithWindows"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Start with Windows"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">
                <ToggleButton x:Name="chkCloseToTray"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Close to Tray"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="chkRunAsAdmin"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Run as Administrator"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="SHORTCUTS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <TextBlock Text="App Hotkey: minimizes or restores DONUT into focus"
                       Style="{DynamicResource SettingsFieldLabel}"
                       Margin="0,0,0,8" />
            <!-- The field owns its clear button, so the row reads as one input plus one action. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8.4" Height="32" Padding="12,0,5,0"
                        VerticalAlignment="Center" Background="{DynamicResource InputFill}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="recGlobalHotkeyValue" Grid.Column="0" Text="No keybind set"
                                   VerticalAlignment="Center" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                   Foreground="{DynamicResource BodyTextPrimary}" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="recGlobalHotkeyClear" Grid.Column="1" ToolTip="Clear"
                                Style="{DynamicResource fieldClearButton}" VerticalAlignment="Center"
                                ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                </Border>
                <Button x:Name="recGlobalHotkeyRecord" Grid.Column="1" Content="Record Keybind"
                        Style="{DynamicResource ButtonSecondary}" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Settings Shortcut: opens Settings while DONUT is focused"
                       Style="{DynamicResource SettingsFieldLabel}"
                       Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="8.4" Height="32" Padding="12,0,5,0"
                        VerticalAlignment="Center" Background="{DynamicResource InputFill}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="recOpenSettingsValue" Grid.Column="0" Text="No keybind set"
                                   VerticalAlignment="Center" FontFamily="{DynamicResource FontSans}" FontSize="13"
                                   Foreground="{DynamicResource BodyTextPrimary}" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="recOpenSettingsClear" Grid.Column="1" ToolTip="Clear"
                                Style="{DynamicResource fieldClearButton}" VerticalAlignment="Center"
                                ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                </Border>
                <Button x:Name="recOpenSettingsRecord" Grid.Column="1" Content="Record Keybind"
                        Style="{DynamicResource ButtonSecondary}" Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="TUNING"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <TextBlock Text="Throttle Limit: machines run at once"
                       Style="{DynamicResource SettingsFieldLabel}"
                       Margin="0,0,0,8" />
            <TextBox x:Name="throttleLimit"
                     Width="120"
                     HorizontalAlignment="Left"
                     Style="{DynamicResource ModernTextBox}" />
            <TextBlock Text="Folders to Scan: largest folders returned"
                       Style="{DynamicResource SettingsFieldLabel}"
                       Margin="0,16,0,8" />
            <TextBox x:Name="folderScanCount"
                     Width="120"
                     HorizontalAlignment="Left"
                     Style="{DynamicResource ModernTextBox}" />
            <TextBlock Text="Lens Software Filter: regex on collection names, blank shows all"
                       Style="{DynamicResource SettingsFieldLabel}"
                       Margin="0,16,0,8" />
            <TextBox x:Name="lensSoftwareCollectionFilter"
                     Style="{DynamicResource ModernTextBox}" />
        </StackPanel>
    </Border>
    <!-- Off by default, and applied live to the app and its worker processes. -->
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="DIAGNOSTICS"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="chkDebugLogging"
                              Style="{DynamicResource ModernToggleSwitch}" />
                <TextBlock Text="Debug Logging"
                           Style="{DynamicResource SettingsToggleLabel}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

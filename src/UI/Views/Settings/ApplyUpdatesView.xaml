<!-- Apply Updates option form. The x:Names are the dcu-cli arg keys the SettingsPresenter
     binder reads and writes, and the shared chip card loads into updateOptionsSlot. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </StackPanel.Resources>
    <Border Style="{DynamicResource Card}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Flags"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <ToggleButton x:Name="silent"
                          Content="Silent"
                          Style="{DynamicResource ModernToggleSwitch}"
                          Margin="0,0,0,10" />
            <ToggleButton x:Name="reboot"
                          Content="Reboot"
                          Style="{DynamicResource ModernToggleSwitch}"
                          Margin="0,0,0,10" />
            <!-- Bound to the toggle, so the warning stays pure XAML with no code behind. -->
            <Border Style="{DynamicResource BadgeAmber}"
                    Height="Auto"
                    Padding="8,4"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    Visibility="{Binding IsChecked, ElementName=reboot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource Warning}"
                          Style="{DynamicResource lucideIcon}"
                          Stroke="{DynamicResource AccentYellow}"
                          Width="11"
                          Height="11"
                          StrokeThickness="0.92"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Restarts the target machines automatically."
                               Style="{DynamicResource BadgeAmberText}"
                               TextWrapping="Wrap"
                               Margin="6,0,0,0" />
                </StackPanel>
            </Border>
            <ToggleButton x:Name="autoSuspendBitLocker"
                          Content="Auto Suspend BitLocker"
                          Style="{DynamicResource ModernToggleSwitch}"
                          Margin="0,0,0,10" />
            <ToggleButton x:Name="forceupdate"
                          Content="Force Update"
                          Style="{DynamicResource ModernToggleSwitch}" />
        </StackPanel>
    </Border>
    <!-- SettingsPresenter fills this with the shared UpdateOptionsView. -->
    <ContentControl x:Name="updateOptionsSlot"
                    Margin="0,0,0,12"
                    Focusable="False"
                    IsTabStop="False" />
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="Text Options"
                       Style="{DynamicResource SettingsSectionLabel}" />
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Output Log"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="outputLog"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Catalog Location"
                           Style="{DynamicResource SettingsFieldLabel}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="catalogLocation"
                         Style="{DynamicResource ModernTextBox}" />
            </StackPanel>
        </StackPanel>
    </Border>
</StackPanel>

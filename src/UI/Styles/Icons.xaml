<!-- App icons, sourced from Lucide (https://lucide.dev) - the library the Arcane/shadcn
     look derives from. Lucide icons are 24x24 STROKE outlines, so consumers render them
     with Stroke (the lucideIcon style below), never Fill - a filled outline skeleton is
     how an icon ends up looking broken. Round caps are load-bearing: Lucide draws dots
     (the ?'s point, the QR pips) as .01-length strokes that only exist via their caps.

     Adding an icon: download the SVG (https://unpkg.com/lucide-static/icons/<name>.svg)
     and run tools\Convert-LucideIcon.ps1 -Path <name>.svg -Key <Key>; paste the line
     here. The comment after each key names its Lucide source icon. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base look for a Lucide Path. Consumers set Stroke (or inherit it from a
         wrapping style), Width/Height, and scale StrokeThickness with size:
         Lucide's native weight is 2/24, so thickness = Width / 12. -->
    <Style x:Key="lucideIcon"
           TargetType="Path">
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Fill"
                Value="{x:Null}" />
        <Setter Property="StrokeThickness"
                Value="1.15" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
    </Style>

    <Geometry x:Key="xMark">M18 6 6 18 M6,6 l12,12</Geometry>

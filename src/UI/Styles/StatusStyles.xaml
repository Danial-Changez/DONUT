<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         Arcane status/badge system (ported from getarcaneapp/arcane).
         StatusBadge recipe: rounded (NOT a pill), 1px border, tinted fill;
         text = the 400-shade accent, 11px semibold. Pair a Badge* Border
         with its Badge*Text TextBlock.
         ============================================================ -->
    <Style x:Key="BadgeGreen"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="8.4" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TintGreen}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TintGreenBorder}" />
    </Style>
    <Style x:Key="BadgeGreenText"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeAmber"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="8.4" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TintAmber}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TintAmberBorder}" />
    </Style>
    <Style x:Key="BadgeAmberText"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentYellow}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeMuted"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="8.4" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    </Style>
    <Style x:Key="BadgeMutedText"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Uppercase micro-label (table headers / stat labels): 11px semibold muted.
         Text stays hand-uppercased - WPF has no letter-spacing/casing property. -->
    <Style x:Key="MicroLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextPrimary}" />
    </Style>
    <!-- Stat tile value (Arcane StatCard). The tile sub-lines stay SelectableText
         TextBoxes (service tag etc. are copy-valuable), so no TextBlock sub style. -->
    <Style x:Key="StatValue"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <!-- Thin usage/progress meter (Arcane dash meter): 5px rounded-full secondary
         track; the fill colour comes from each instance's Foreground (VM-driven).
         PART_Track / PART_Indicator names are required for indicator sizing.
         Indeterminate renders full-width (WPF sets percent=1) with a pulse. -->
    <Style x:Key="ThinProgressBar"
           TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{DynamicResource Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2.5" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2.5"
                                HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate"
                                 Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="pulse">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0.35"
                                                         Duration="0:0:0.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

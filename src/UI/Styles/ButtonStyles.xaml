<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Control bar button -->
    <Style x:Key="controlButton"
           TargetType="Button">
        <!-- Normal button style -->
        <Setter Property="Width"
                Value="50" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextTertiary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Square hover pad: these buttons sit flush in window corners. -->
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Button style when hovering -->
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource PanelBackgroundActive}" />
                <Setter Property="Foreground"
                        Value="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Card-corner close: the controlButton pad with its top-right rounded (9 = the
         card's 10 minus the 1px border) so it sits flush in a radius-10 overlay card. -->
    <Style x:Key="controlButtonCardClose"
           TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextTertiary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0,9,0,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundActive}" />
                <Setter Property="Foreground" Value="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Control button icon. FlowDirection is pinned LTR: the control bar's button
         stack is RightToLeft (the dock-right idiom) and Paths inherit it, which
         mirrors every glyph - only the asymmetric ones (the tour's ?) show it. -->
    <Style x:Key="controlButtonIcon"
           TargetType="Path">
        <Setter Property="Width"
                Value="10" />
        <Setter Property="Height"
                Value="10" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
        <Setter Property="Fill"
                Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
        <!-- Circular image button: hit area is the circle only -->
        <Style x:Key="circleImageButton"
                   TargetType="Button">
                <Setter Property="Width" Value="165" />
                <Setter Property="Height" Value="165" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <!-- Root has no background so clicks outside the ellipse don't register -->
                                        <Grid>
                                                <!-- Image fill bound to Background to allow runtime ImageBrush -->
                                                <Ellipse x:Name="ellipseBg"
                                                                 Stretch="Fill"
                                                                 Fill="{TemplateBinding Background}" />
                                                <!-- Optional hover ring -->
                                                <Ellipse x:Name="hoverRing"
                                                                 Stretch="Fill"
                                                                 Fill="Transparent"
                                                                 StrokeThickness="0"
                                                                 Stroke="{DynamicResource PanelBackgroundActive}" />
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="hoverRing" Property="StrokeThickness" Value="2" />
                                                        <Setter TargetName="hoverRing" Property="Stroke" Value="{DynamicResource TitleTextPrimary}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ellipseBg" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ellipseBg" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>
    <!-- ============================================================
         Arcane button system (ported from getarcaneapp/arcane at its real
         14px root scale). Shared: rounded-lg (8.4), h-9 (32), px-4 (14),
         text-sm (12.5), font-medium, disabled opacity 0.5. CTAs and
         destructive actions use the ButtonTint* variants below.
         ============================================================ -->
    <!-- secondary: bg-secondary text-secondary-foreground hover:bg-secondary/80 -->
    <Style x:Key="ButtonSecondary"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- outline: bg-card/60 border hover:bg-card/90 hover:text-accent-foreground -->
    <Style x:Key="ButtonOutline"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ghost: transparent hover:bg-card/60 hover:text-accent-foreground -->
    <Style x:Key="ButtonGhost"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBackgroundHover}" />
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource TitleTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- In-field clear (the X inside an input). Dim and inert when there is nothing to
         clear, destructive on hover when there is, so the affordance encodes its own state. -->
    <Style x:Key="fieldClearButton"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <Path x:Name="glyph"
                              Data="{DynamicResource xMark}"
                              Width="9"
                              Height="9"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource Destructive}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <!-- Nothing to clear: no hand cursor, no hover colour, just dim. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="glyph" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Arcane secondary "pill": a filled zinc surface used for the Mode cycle button.
         Same family as ButtonSecondary but pill-padded (14,7). Named ButtonPill because
         it is NOT a ghost button - the real ghost variant is ButtonGhost above. -->
    <Style x:Key="ButtonPill"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelBackgroundActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ============================================================
         ArcaneButton tinted action variants: tinted glass outline keyed to the
         action's semantic color - bg {c}@10%, border {c}@30%, text = 400 shade;
         hover lifts to @20%/@40%. Arcane uses these (not solid fills) for
         start/stop/scan-style actions.
         ============================================================ -->
    <!-- Arcane outline-primary: dark violet tint with NEAR-WHITE text (not violet),
         so the primary action reads deep/subtle rather than loud. -->
    <Style x:Key="ButtonTintPrimary"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource TintViolet}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TintVioletBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintVioletHover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TintVioletBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ButtonTintSuccess"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource TintGreen}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGreen}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TintGreenBorder}" />
        <Setter Property="BorderThickness" Value="1" />

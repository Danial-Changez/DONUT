<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Transparent because HomeView's SearchBox border carries the fill and focus ring. -->
    <Style x:Key="GoogleSearchBar"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="MinWidth"
                Value="200" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="Center" />
                        <!-- The watermark names both modes of the bar for a first-time user. -->
                        <TextBlock x:Name="Placeholder"
                                   Text="WSID to add  ·  or search a name"
                                   Foreground="{DynamicResource BodyTextPrimary}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="1,0,0,0"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text"
                                 Value="">
                            <Setter TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text"
                                 Value="{x:Null}">
                            <Setter TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A TextBox so detail values can be copied. No ellipsis, so long values clip. -->
    <Style x:Key="SelectableText"
           TargetType="TextBox">
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="IsReadOnlyCaretVisible"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="AcceptsReturn"
                Value="False" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Cursor"
                Value="IBeam" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Hidden" />
    </Style>
    <!-- SelectableText for the disk tree labels, where the root row reads brighter. -->
    <Style x:Key="SelectableTreeLabel"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableText}">
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRoot}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource TitleTextPrimary}" />
            </DataTrigger>
            <!-- A user profile selected to be cleared reads as the hazard it is. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsUserDir}"
                               Value="True" />
                    <Condition Binding="{Binding IsSelected}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentYellow}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <!-- SelectableText that also copies. Tag carries the raw value, since the rendered one
         may be decorated; MainPresenter reads it on a click that selected nothing. -->
    <Style x:Key="CopyableValue"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableText}">
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="ToolTip"
                Value="Copy" />
        <Setter Property="Padding"
                Value="4,1" />
        <!-- -5 = the pill's 1px border + its 4px padding, so the text sits on the value's origin. -->
        <Setter Property="Margin"
                Value="-5,0,0,0" />
        <!-- The pill hugs the value with equal side padding; the cap keeps a long one clipped. -->
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="MaxWidth"
                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Panel}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- No Padding here: the TextBox already applies its own inside the content host. -->
                    <Border x:Name="pill"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="pill"
                                    Property="Background"
                                    Value="{DynamicResource SurfaceMuted}" />
                            <Setter TargetName="pill"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PanelBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- SelectableText for optional notes: wraps, and collapses when there is no text. -->
    <Style x:Key="SelectableNote"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableText}">
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text"
                     Value="">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- SelectableText at the stat headline tier. A TextBox cannot trim, so the tooltip
         these carry is what reveals a clipped value. -->
    <Style x:Key="StatValue"
           TargetType="TextBox"
           BasedOn="{StaticResource SelectableText}">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <!-- Montserrat sits taller than Segoe UI: 10 here is 16 of ink gap under the label. -->
        <Setter Property="Margin"
                Value="0,10,0,0" />
    </Style>
    <!-- Strips the default selection visuals, the row templates draw their own. -->
    <Style x:Key="MachineListItem"
           TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModernTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource InputFill}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Height"
                Value="32" />
        <!-- One space of inset, not a gutter. The old 10 read too airy. -->
        <Setter Property="Padding"
                Value="4,0" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
        <!-- Stretch so a width-less field fills its card instead of collapsing. -->
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8.4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource InputBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource InputBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Bd"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                        <!-- Set from code, and last so it beats the focus ring. -->
                        <Trigger Property="Tag"
                                 Value="error">
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Destructive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModernCheckBox"
           TargetType="CheckBox">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
        <Setter Property="Margin"
                Value="0,0,16,8" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="box"
                                Width="16"
                                Height="16"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Left">
                            <Grid>
                                <Path x:Name="check"
                                      Data="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"
                                      Visibility="Collapsed"
                                      Height="10"
                                      Width="10"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryForeground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <!-- Indeterminate (some children checked): a dash, not a tick. -->
                                <Rectangle x:Name="dash"
                                           Width="8"
                                           Height="2"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{DynamicResource PrimaryForeground}"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="box"
                                    Property="Background"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="check"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="{x:Null}">
                            <Setter TargetName="box"
                                    Property="Background"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="dash"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A card heading at the TextSubtitle tier, since an all-caps eyebrow on every card read as noise. -->
    <Style x:Key="SettingsSectionLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="Margin"
                Value="0,0,0,12" />
    </Style>
    <!-- Margin is left to instances, spacing differs above a textbox and above chips. -->
    <Style x:Key="SettingsFieldLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
    </Style>
    <!-- Stays a CheckBox so the settings binder can read Content and IsChecked. -->
    <Style x:Key="ChipCheckBox"
           TargetType="CheckBox">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="Margin"
                Value="0,0,8,8" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="chip"
                            CornerRadius="6.7"
                            Padding="12,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource InputBorder}"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="chip"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="chip"
                                    Property="Background"
                                    Value="{DynamicResource TintViolet}" />
                            <Setter TargetName="chip"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TintVioletBorder}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentPurpleLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A RadioButton so the segments stay mutually exclusive. -->
    <Style x:Key="SegmentToggle"
           TargetType="RadioButton">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Medium" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <!-- Instances such as the compact Home filter override this padding. -->
        <Setter Property="Padding"
                Value="18,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="seg"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TitleTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="seg"
                                    Property="Background"
                                    Value="{DynamicResource SurfaceSolid}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TitleTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- MinHeight keeps the Track-sized thumb grabbable on very long content. -->
    <Style x:Key="ScrollBarTrackThumb"
           TargetType="Thumb">
        <Setter Property="MinHeight"
                Value="24" />
        <Setter Property="Width"
                Value="7" />
        <Setter Property="Background"
                Value="{DynamicResource ScrollThumb}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid x:Name="Grid">
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Width="Auto"
                                   Height="Auto"
                                   Fill="Transparent" />
                        <Border x:Name="CornerScrollBarRectangle"
                                CornerRadius="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Width="Auto"
                                Height="Auto"
                                Margin="0,1,0,1"
                                Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag"
                                 Value="Horizontal">
                            <Setter TargetName="CornerScrollBarRectangle"
                                    Property="Width"
                                    Value="Auto" />
                            <Setter TargetName="CornerScrollBarRectangle"
                                    Property="Height"
                                    Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InvisibleRepeatButton"
           TargetType="RepeatButton">
        <Setter Property="Width"
                Value="0" />
        <Setter Property="Height"
                Value="0" />
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Foreground"
                Value="{DynamicResource PanelBackgroundActive}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Width"
                Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot"
                          Width="7"
                          Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Bound, not NaN, so thumb length tracks the overflow. -->
                        <Track x:Name="PART_Track"
                               Grid.Row="0"
                               IsDirectionReversed="true"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Focusable="false">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Background="{TemplateBinding Foreground}"
                                       Style="{DynamicResource ScrollBarTrackThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageUp"
                                              Command="ScrollBar.PageDownCommand"
                                              Style="{DynamicResource InvisibleRepeatButton}"
                                              Focusable="false" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageDown"
                                              Command="ScrollBar.PageUpCommand"
                                              Style="{DynamicResource InvisibleRepeatButton}"
                                              Focusable="false" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Thumb"
                                 Property="IsMouseOver"
                                 Value="true">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                        <Trigger SourceName="Thumb"
                                 Property="IsDragging"
                                 Value="true">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource BodyTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter TargetName="Thumb"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation"
                                 Value="Horizontal">
                            <Setter TargetName="GridRoot"
                                    Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track"
                                    Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Width"
                                    Value="Auto" />
                            <Setter Property="Height"
                                    Value="8" />
                            <Setter TargetName="Thumb"
                                    Property="Tag"
                                    Value="Horizontal" />
                            <Setter TargetName="PageDown"
                                    Property="Command"
                                    Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageUp"
                                    Property="Command"
                                    Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Content is the label, so switch and label are one hit target with no dead zone. -->
    <Style x:Key="ModernToggleSwitch"
           TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <DockPanel x:Name="Root"
                               Background="Transparent"
                               LastChildFill="True">
                        <Grid DockPanel.Dock="Left"
                              Width="36"
                              Height="20"
                              VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceMuted}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1" />
                            <Ellipse x:Name="SwitchThumb"
                                     Width="14"
                                     Height="14"
                                     Fill="{DynamicResource TitleTextPrimary}"
                                     Margin="3,3,0,3"
                                     HorizontalAlignment="Left" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="12,0,0,0" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="SwitchTrack"
                                    Property="Background"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="SwitchTrack"
                                    Property="BorderBrush"
                                    Value="Transparent" />
                            <Setter TargetName="SwitchThumb"
                                    Property="Fill"
                                    Value="{DynamicResource PrimaryForeground}" />
                            <Setter TargetName="SwitchThumb"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter TargetName="SwitchThumb"
                                    Property="Margin"
                                    Value="0,3,3,3" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="SwitchTrack"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Root"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DiskTree" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
    </Style>

    <Style x:Key="DiskTreeItem" TargetType="{x:Type TreeViewItem}">
        <!-- Roots expand and deeper levels stay collapsed, keeping the panel compact. -->
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander"
                                      Grid.Row="0" Grid.Column="0"
                                      Focusable="False"
                                      ClickMode="Press"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" Width="16" Height="16">
                                        <Path x:Name="Arrow"
                                              Data="M0,0 L4,4 L0,8 Z"
                                              Fill="{DynamicResource BodyTextTertiary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Padding="2,2,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" />
                        </Border>

                        <Border x:Name="ItemsBorder"
                                Grid.Row="1" Grid.Column="1"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1,0,0,0"
                                Margin="2,0,0,0" Padding="8,0,0,0">
                            <ItemsPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="ItemsBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Depth}" Value="0">
                <Setter Property="IsExpanded" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Embedded search input: fully transparent - the composed search bar (HomeView's
         SearchBox border) carries the fill and focus ring, so icon, text, and button
         read as one Arcane input surface instead of nested boxes. -->
    <Style x:Key="GoogleSearchBar"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13.5" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="MinWidth"
                Value="200" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="Center" />
                        <!-- Placeholder watermark: conveys both modes of the bar (add
                             machines vs. search a person/PC) for a first-time user. -->
                        <TextBlock x:Name="Placeholder"
                                   Text="WSID to add  ·  or search a name"
                                   Foreground="{DynamicResource BodyTextPrimary}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="1,0,0,0"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text"
                                 Value="">
                            <Setter TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text"
                                 Value="{x:Null}">
                            <Setter TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RichTextBox">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource TerminalText}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Margin"
                Value="10" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="Focusable"
                Value="True" />
    </Style>
    <!-- implicit style for all TextBox controls -->
    <Style TargetType="TextBox">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource TerminalText}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="AcceptsReturn"
                Value="True" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Hidden" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Hidden" />
        <Setter Property="Margin"
                Value="10" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="Focusable"
                Value="True" />
    </Style>
    <!-- Reads like a TextBlock but lets the user select + copy the text. Keyed (not
         implicit), so it fully replaces the implicit TextBox style above: used for the
         machine-detail values (host, IP, service tag, disk, folder rows). Font + colour
         come from each instance; no ellipsis (TextBox has none) so long values clip. -->
    <Style x:Key="SelectableText"
           TargetType="TextBox">
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="IsReadOnlyCaretVisible"
                Value="False" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="AcceptsReturn"
                Value="False" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Cursor"
                Value="IBeam" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Hidden" />
    </Style>
    <!-- style for each tab header -->
    <Style x:Key="TerminalTabItemStyle"
           TargetType="TabItem">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Margin"
                Value="2,0,2,0" />
        <Setter Property="Padding"
                Value="10,5" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource TerminalText}" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PanelBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8,8,0,0"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource SurfaceSolid}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource PanelBackgroundHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- style for the TabControl -->
    <Style x:Key="TerminalTabControlStyle"
           TargetType="TabControl">
        <Setter Property="Background"
                Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource TerminalTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel"
                                  Background="{TemplateBinding Background}"
                                  IsItemsHost="True" />
                        <ContentPresenter Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern TextBox: Arcane boxed input - white@12% fill, rounded-lg, no border
         until focus paints the primary ring. -->
    <Style x:Key="ModernTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource InputFill}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Padding"
                Value="10,0" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
        <!-- Stretch so a width-less field fills its card instead of collapsing to
             content width (~1 char); fields with an explicit Width keep it. -->
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8.4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource InputBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource InputBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Bd"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                        <!-- Validation error: red border, flagged via Tag='error' set
                             imperatively when a field fails to save. Last, so it wins
                             over the focus ring. -->
                        <Trigger Property="Tag"
                                 Value="error">
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Destructive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern ComboBox: Arcane boxed select - input fill, rounded-lg, primary ring
         when open; popup is a solid surface card. -->
    <Style x:Key="ModernComboBox"
           TargetType="ComboBox">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
        <Setter Property="Background"
                Value="{DynamicResource InputFill}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Height"
                Value="32" />
        <Setter Property="Padding"
                Value="2,2,2,2" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground"
                            Value="{DynamicResource BodyTextPrimary}" />
                    <Setter Property="Padding"
                            Value="10,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBd"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Margin="4,1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted"
                                             Value="True">
                                        <Setter TargetName="itemBd"
                                                Property="Background"
                                                Value="{DynamicResource PanelBackgroundHover}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TitleTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="itemBd"
                                                Property="Background"
                                                Value="{DynamicResource TintViolet}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TitleTextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8.4">
                            <DockPanel LastChildFill="False">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="12,0,0,0"
                                                  Width="Auto" />
                                <!-- Visual-only arrow -->
                                <Grid Width="32"
                                      DockPanel.Dock="Right"
                                      HorizontalAlignment="Right">
                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 8 0 L 4 4 Z"
                                          Fill="{DynamicResource BodyTextPrimary}"
                                          Width="12"
                                          Height="8"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <!-- Overlay an invisible ToggleButton to open dropdown on any click except the arrow -->
                        <ToggleButton x:Name="OverlayToggle"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Margin="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource SurfaceSolid}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8.4"
                                    Margin="0,4,0,0"
                                    Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource InputBorder}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern GroupBox Style -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin"
                Value="0,0,0,18" />
        <Setter Property="Padding"
                Value="10" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Background"
                Value="{DynamicResource GroupBoxBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PanelBorder}" />
        <Setter Property="BorderThickness"
                Value="1" />
    </Style>
    <!-- Modern CheckBox: shadcn-sized 16px box, primary fill when checked. -->
    <Style x:Key="ModernCheckBox"
           TargetType="CheckBox">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
        <Setter Property="Margin"
                Value="0,0,16,8" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="box"
                                Width="16"
                                Height="16"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorder}"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Left">
                            <Grid>
                                <Path x:Name="check"
                                      Data="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"
                                      Visibility="Collapsed"
                                      Height="10"
                                      Width="10"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryForeground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="box"
                                    Property="Background"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="check"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern Section Subtitle Style for Config Option Panels -->
    <Style x:Key="ModernSectionSubtitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
        <Setter Property="Margin"
                Value="0,12,0,4" />
    </Style>
    <!-- Uppercase micro-label heading for the settings sub-cards (matches Home). -->
    <Style x:Key="SettingsSectionLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <!-- Arcane table-header/stat-label muted tone (matches MicroLabel). -->
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
        <Setter Property="Margin"
                Value="0,0,0,10" />
    </Style>
    <!-- Label sitting to the right of a ModernToggleSwitch in the settings forms. -->
    <Style x:Key="SettingsToggleLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13.5" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextSecondary}" />
        <Setter Property="Margin"
                Value="12,0,0,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
    <!-- Caption above a settings field or chip group. Instances set Margin (4 above
         a textbox, 8 above chips) and TextWrapping where the copy is long. -->
    <Style x:Key="SettingsFieldLabel"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="12.5" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextPrimary}" />
    </Style>
    <!-- Chip-style CheckBox for multi-select config tokens: a pill that fills accent
         when checked. Stays a CheckBox so the binder reads Content + IsChecked. -->
    <Style x:Key="ChipCheckBox"
           TargetType="CheckBox">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="12.5" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="Margin"
                Value="0,0,8,8" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="chip"
                            CornerRadius="6.7"
                            Padding="12,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource InputBorder}"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="chip"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="chip"
                                    Property="Background"
                                    Value="{DynamicResource TintViolet}" />
                            <Setter TargetName="chip"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TintVioletBorder}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentPurpleLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Segmented pill toggle: two in a rounded track make the Scan/Apply command
         picker. Checked segment fills accent; RadioButton keeps them exclusive. -->
    <Style x:Key="SegmentToggle"
           TargetType="RadioButton">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="Medium" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="seg"
                            CornerRadius="7"
                            Padding="18,7"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TitleTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="seg"
                                    Property="Background"
                                    Value="{DynamicResource SurfaceSolid}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TitleTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Scrollbar Styles moved from ButtonStyles.xaml -->
    <!-- Thumb has no fixed length: the Track sizes it from the viewport/content ratio
         (see ViewportSize below). MinHeight keeps a tiny thumb grabbable on long content. -->
    <Style x:Key="ScrollBarTrackThumb"
           TargetType="Thumb">
        <Setter Property="MinHeight"
                Value="24" />
        <Setter Property="Width"
                Value="7" />
        <Setter Property="Background"
                Value="{DynamicResource ScrollThumb}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid x:Name="Grid">
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Width="Auto"
                                   Height="Auto"
                                   Fill="Transparent" />
                        <Border x:Name="CornerScrollBarRectangle"
                                CornerRadius="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Width="Auto"
                                Height="Auto"
                                Margin="0,1,0,1"
                                Background="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag"
                                 Value="Horizontal">
                            <Setter TargetName="CornerScrollBarRectangle"
                                    Property="Width"
                                    Value="Auto" />
                            <Setter TargetName="CornerScrollBarRectangle"
                                    Property="Height"
                                    Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Invisible RepeatButton for ScrollBar -->
    <Style x:Key="InvisibleRepeatButton"
           TargetType="RepeatButton">
        <Setter Property="Width"
                Value="0" />
        <Setter Property="Height"
                Value="0" />
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton" />
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Neutral zinc scrollbar (Arcane): quiet thumb, brightens on hover/drag. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Foreground"
                Value="{DynamicResource PanelBackgroundActive}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Width"
                Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot"
                          Width="7"
                          Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- ViewportSize bound (not NaN) so the thumb length tracks how much
                             content overflows - a big thumb when there's little to scroll. -->
                        <Track x:Name="PART_Track"
                               Grid.Row="0"
                               IsDirectionReversed="true"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Focusable="false">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Background="{TemplateBinding Foreground}"
                                       Style="{DynamicResource ScrollBarTrackThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageUp"
                                              Command="ScrollBar.PageDownCommand"
                                              Style="{DynamicResource InvisibleRepeatButton}"
                                              Focusable="false" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageDown"
                                              Command="ScrollBar.PageUpCommand"
                                              Style="{DynamicResource InvisibleRepeatButton}"
                                              Focusable="false" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Thumb"
                                 Property="IsMouseOver"
                                 Value="true">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                        <Trigger SourceName="Thumb"
                                 Property="IsDragging"
                                 Value="true">
                            <Setter TargetName="Thumb"
                                    Property="Background"
                                    Value="{DynamicResource BodyTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter TargetName="Thumb"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation"
                                 Value="Horizontal">
                            <Setter TargetName="GridRoot"
                                    Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track"
                                    Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Width"
                                    Value="Auto" />
                            <Setter Property="Height"
                                    Value="8" />
                            <Setter TargetName="Thumb"
                                    Property="Tag"
                                    Value="Horizontal" />
                            <Setter TargetName="PageDown"
                                    Property="Command"
                                    Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageUp"
                                    Property="Command"
                                    Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern Toggle Switch: shadcn switch - 36x20 muted track, primary when on. -->
    <Style x:Key="ModernToggleSwitch"
           TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle"
                Value="{DynamicResource FocusRingVisual}" />
        <Setter Property="Width"
                Value="36" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root"
                          Width="36"
                          Height="20">
                        <!-- Track -->
                        <Border x:Name="SwitchTrack"
                                Width="36"
                                Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1" />
                        <!-- Thumb -->
                        <Ellipse x:Name="SwitchThumb"
                                 Width="14"
                                 Height="14"
                                 Fill="{DynamicResource TitleTextPrimary}"
                                 Margin="3,3,0,3"
                                 HorizontalAlignment="Left" />
                        <!-- Label (optional) -->
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Margin="0,0,8,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="SwitchTrack"
                                    Property="Background"
                                    Value="{DynamicResource Primary}" />
                            <Setter TargetName="SwitchTrack"
                                    Property="BorderBrush"
                                    Value="Transparent" />
                            <Setter TargetName="SwitchThumb"
                                    Property="Fill"
                                    Value="{DynamicResource PrimaryForeground}" />
                            <Setter TargetName="SwitchThumb"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter TargetName="SwitchThumb"
                                    Property="Margin"
                                    Value="0,3,3,3" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="SwitchTrack"
                                    Property="BorderBrush"
                                    Value="{DynamicResource BodyTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="Root"
                                    Property="Opacity"
                                    Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Storage-scan folder tree: transparent host + dark-themed TreeViewItem with a
         rotating chevron and a subtle left guide line per nesting level. -->
    <Style x:Key="DiskTree" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
    </Style>

    <Style x:Key="DiskTreeItem" TargetType="{x:Type TreeViewItem}">
        <!-- Roots start expanded, deeper levels collapsed (keeps the panel compact).
             Depth comes from the bound FolderNodeViewModel. -->
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BodyTextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander"
                                      Grid.Row="0" Grid.Column="0"
                                      Focusable="False"
                                      ClickMode="Press"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" Width="16" Height="16">
                                        <Path x:Name="Arrow"
                                              Data="M0,0 L4,4 L0,8 Z"
                                              Fill="{DynamicResource BodyTextTertiary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Padding="2,2,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" />
                        </Border>

                        <Border x:Name="ItemsBorder"
                                Grid.Row="1" Grid.Column="1"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1,0,0,0"
                                Margin="2,0,0,0" Padding="8,0,0,0">
                            <ItemsPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="ItemsBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Depth}" Value="0">
                <Setter Property="IsExpanded" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
<!-- Shape tokens + shared container styles. Colours/fonts live in UIColors.xaml; this
     file holds the corner-radius scale and the Card recipe that views hand-built as raw
     Borders. Consumed via DynamicResource, so merge order does not matter. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Corner-radius scale (was scattered magic numbers: 6 / 6.7 / 7 / 8.4 / 9 / 10). -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusChip">7</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8.4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>

    <!-- Shared card container: the PanelBackground + PanelBorder recipe every settings
         and Home sub-card repeated by hand. Instances still set Margin (and override
         Padding where a denser card is wanted). -->
    <Style x:Key="Card"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PanelBorder}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource RadiusCard}" />
        <Setter Property="Padding"
                Value="16,14" />
    </Style>

    <!-- Named text roles. TitleText/BodyText etc. existed only as *brushes*; these are the
         matching TextBlock styles so headings/body copy stop being styled ad-hoc inline.
         Values are the dominant ones already in use (a starting scale for future adoption). -->
    <Style x:Key="TextTitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
    </Style>
    <Style x:Key="TextSubtitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TitleTextPrimary}" />
    </Style>
    <Style x:Key="TextBody"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextSecondary}" />
    </Style>
    <Style x:Key="TextBodyMuted"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontSans}" />
        <Setter Property="FontSize"
                Value="12.5" />
        <Setter Property="Foreground"
                Value="{DynamicResource BodyTextTertiary}" />
    </Style>
    <Style x:Key="TextMono"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource TerminalText}" />
    </Style>
</ResourceDictionary>

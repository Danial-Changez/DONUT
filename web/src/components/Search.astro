---
/**
 * Search + a "Quick links" empty state, WITHOUT forking Starlight's Search.
 *
 * We render Starlight's stock <Search> (imported by its full path, so this
 * override wraps it rather than replacing it) and inject a quick-links panel
 * into the live dialog at runtime. That keeps us on the latest upstream Search
 * on every build; the only coupling is the dialog's outer shell (the
 * `site-search` element, its `dialog`, and `.dialog-frame`).
 *
 * The panel shows while the query is empty and hides once it has text
 * (site-search[data-searching] .dw-quick-links in styles/custom.css).
 */
import Default from '@astrojs/starlight/components/Search.astro';
import { Icon } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const quickLinks = [
  { label: 'What is DONUT?', href: `${base}/get-started/what-is-donut/` },
  { label: 'Installation', href: `${base}/get-started/installation/` },
  { label: 'Scanning for updates', href: `${base}/features/scanning/` },
  { label: 'Applying updates', href: `${base}/features/applying-updates/` },
  { label: 'Active Directory finder', href: `${base}/features/ad-finder/` },
  { label: 'User Lens', href: `${base}/features/user-lens/` },
  { label: 'config.json reference', href: `${base}/configuration/config-reference/` },
  { label: 'DCU command reference', href: `${base}/configuration/dcu-commands/` },
];
---

<Default {...Astro.props} />

{/* Cloned into the dialog by the script below (kept out of the dialog until then). */}
<template class="dw-quick-links-tpl">
  <nav class="dw-quick-links" aria-label="Quick links">
    <p class="dw-quick-links-label">Quick links</p>
    <ul>
      {
        quickLinks.map((link) => (
          <li>
            <a href={link.href}>
              {link.label}
              <Icon name="right-arrow" size="0.875rem" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</template>

<script>
  // Inject the quick-links panel into each search dialog and mirror "has the
  // query got text?" onto site-search[data-searching] so the CSS can swap the
  // panel for results. Delegated from the dialog because Pagefind's input mounts
  // asynchronously; the deferred click re-check covers its clear button, which
  // changes the value without firing an input event.
  const template = document.querySelector<HTMLTemplateElement>('template.dw-quick-links-tpl');
  if (template) {
    for (const search of document.querySelectorAll('site-search')) {
      const frame = search.querySelector('.dialog-frame');
      if (frame && !frame.querySelector('.dw-quick-links')) {
        frame.appendChild(template.content.cloneNode(true));
      }
      const dialog = search.querySelector('dialog');
      const sync = () => {
        const query = search.querySelector('input')?.value ?? '';
        search.toggleAttribute('data-searching', query.trim().length > 0);
      };
      dialog?.addEventListener('input', sync);
      dialog?.addEventListener('click', () => setTimeout(sync, 0));
    }
  }
</script>

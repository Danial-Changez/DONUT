@startuml class_config
title DONUT — Configuration, persistence & self-update
skinparam classAttributeIconSize 0

' Subsystem cut of the retired all-in-one class diagram: config/persistence,
' logging/provenance, the recents store, startup-task plumbing, and self-update.
' Cross-subsystem wiring lives in component_diagram.
package "Donut.Core" #102A20 {
    class ConfigManager {
        +SourceRoot: string
        +LoadConfig(): AppConfig
        +SaveConfig(config): void
        +EnsureDirectories(): void
    }

    class LogService {
        +LogInfo(message): void
        +LogError(message): void
        +LogWarning(message): void
        +LogDebug(message): void
        +LogException(message, errorRecord): void
        +LogStructured(level, eventName, fields): void
        +GetRecentLogs(count): string[]
        +{static} Coalesce(logger): LogService
    }
    class NullLogService extends LogService

    class TimeFormat {
        +{static} Relative(when): string
        +{static} ParseIso(value): datetime
    }

    enum ElevationState {
        NotRequired
        Satisfied
        RelaunchRequired
    }

    class DonutPaths {
        +{static} DataRoot(): string
        +{static} ConfigDir() / LogsDir() / ReportsDir(): string
        +{static} LegacyRoot(): string
        +{static} Secure(dir): string
    }

    class ElevationContext {
        +{static} IsElevated(): bool
        +{static} IsSystem(): bool
        +{static} CurrentIdentityName(): string
        +{static} InteractiveUser(): string
        +{static} Classify(actionNeedsAdmin, isElevated): ElevationState
    }
    ElevationContext ..> ElevationState
    DonutPaths ..> ElevationContext

    class ElevationRelaunch {
        +{static} BuildSpec(sourceRoot): Hashtable
        +{static} Spawn(spec): Hashtable
    }

    enum GatedAction {
        RunAll
        Run
        Inventory
        DiskScan
        DeleteFolders
        StartupTask
    }

    class PendingIntent {
        +Action: GatedAction
        +Hosts: string[]
        +CreatedUtc: string
        +{static} Create(action, hosts, nowUtc): PendingIntent
        +{static} FromJson(json): PendingIntent
        +IsResumable(): bool
        +IsFresh(nowUtc, ttl): bool
        +ToJson(): string
    }
    PendingIntent ..> GatedAction

    class BuildProvenance {
        +{static} Stamp(sourceRoot): string
    }

    class ViewLoader {
        +{static} Load(sourceRoot, relativePath): object
    }
}

package "Donut.Services" #221634 {
    class RecentConnectionsStore {
        +{static} Cap: int
        +DeferSave: bool
        +Upsert(host, status, jobType, count, reboot): void
        +Touch(host): void
        +UpsertInventory(host, inv): void
        +UpsertOwner(host, owner): void
        +UpsertDiskUsage(host, report): void
        +Remove(host): void
        +SeedFrom(hosts): void
        +GetAll(): RecentConnection[]
        +GetByHost(host): RecentConnection
        +Count(): int
        +FlushSave(): void
    }

    class PendingIntentStore {
        +Logger: LogService
        +Ttl: timespan
        +IntentPath(): string
        +Save(intent): void
        +Take(nowUtc): PendingIntent
        +Discard(): void
    }

    class ResourceService {
        +LoadGlobalResources(): ResourceDictionary
        +ApplyResourcesToWindow(window): void
    }

    class SelfUpdateService {
        +GetStoredToken(): string
        +SaveToken(tokenData): void
        +InitiateDeviceFlow(): PSCustomObject
        +PollForToken(deviceCode): PSCustomObject
        +GetLatestRelease(token): PSCustomObject
        +DownloadAsset(token, asset, destDir): string
        +VerifyFileHash(path, expectedHash): bool
        +ApplyUpdate(msiPath, isRollback, sourceRoot): void
    }

    class StartupTaskService {
        +Logger: LogService
        +SourceRoot: string
        +{static} TaskNameFor(user): string
        +ResolveOwner(): Hashtable
        +BuildLaunchSpec(processPath, sourceRoot): Hashtable
        +ReconcileDecision(enabled, existingTask, spec): string
        +Apply(enabled): bool
    }
}

package "Donut.Models" #15233B {
    class AppConfig {
        +SourceRoot: string
        +LogsPath: string
        +ReportsPath: string
        +Settings: Hashtable
        +{static} Defaults: Hashtable
        --
        +GetSetting(key, default): object
        +SetSetting(key, value): void
        +GetActiveCommand(): string
        +GetCommandArgs(command): Hashtable
        +GetThrottleLimit(): int
        +BuildDcuArgs(command, overrides): string
        -MergeWithDefaults(userSettings): Hashtable
    }

    class RecentConnection {
        +Hostname: string
        +LastSeen: string
        +LastTouched: string
        +LastStatus: string
        +LastJobType: string
        +UpdateCount: int
        +RebootRequired: bool
        +Owner: string
        +Inventory: MachineInventory
        +DiskUsage: DiskUsageReport
        +{static} FromHashtable(h): RecentConnection
    }

    enum PollOutcome {
        Authorized
        KeepPolling
        SlowDown
        Failed
    }

    class DeviceFlowDecision {
        +Outcome: PollOutcome
        +TokenData: object
        +Message: string
        +{static} FromPollResult(result): DeviceFlowDecision
    }
}

ConfigManager ..> AppConfig
RecentConnectionsStore --> RecentConnection
DeviceFlowDecision ..> PollOutcome
StartupTaskService --> LogService
PendingIntentStore --> LogService
PendingIntentStore ..> PendingIntent

@enduml

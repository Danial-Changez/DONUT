@startuml class_runspaces
title DONUT — Runspaces & workers
skinparam classAttributeIconSize 0

' Subsystem cut of the retired all-in-one class diagram: the job/runspace
' infrastructure only. Cross-subsystem wiring lives in component_diagram.
package "Donut.Core" #102A20 {
    class RunspaceManager {
        +{static} InteractiveSize: int
        +{static} Logger: LogService
        +{static} Initialize(min, max): void
        +{static} GetPool(): RunspacePool
        +{static} GetInteractivePool(): RunspacePool
        +{static} Close(): void
    }

    class AsyncJob {
        +HostName: string
        +JobType: JobKind
        +Status: JobStatus
        +Logs: ConcurrentQueue<LogLine>
        +Result: object
        +FailureMessage: string
        +StartedAtUtc: datetime
        +Start(scriptPath, arguments, tempConfig): void
        +Poll(): void
        +DrainStream(stream, severity): void
        +Cleanup(): void
        -LogStallHeartbeat(): void
    }

    class WorkerProcess {
        +{static} $Launcher: scriptblock
        +{static} FindPwsh(): string
        +{static} Prepare(scriptPath, arguments, configPath): hashtable
        +{static} Interpret(launcherOutput): hashtable
    }

    class ResolveProcessJob extends AsyncJob {
        +Process: Process
        +ProcessFault: bool
        +TimeoutSeconds: int
        +Start(scriptPath, arguments, tempConfig): void
        +Poll(): void
        +Cleanup(): void
        -KillChild(why): void
    }

    class PoolScriptJob {
        +{static} Start(scriptPath, parameters): Hashtable
        +{static} Complete(job, logger): object
        +{static} DisposeSafe(ps, stoppingList, logger): bool
        +{static} ReapStopping(stoppingList, logger): bool
    }

    class DispatcherWatchdog {
        +Start(): void
        +Reset(): void
    }
}

package "Donut.Models" #15233B {
    enum JobStatus {
        Created
        Running
        Completed
        Failed
    }

    enum JobKind {
        Scan
        UpdateScan
        UpdateApply
        Inventory
        DiskScan
        DeleteFolders
        Resolve
    }

    enum LogSeverity {
        Info
        Warn
        Error
        Success
    }

    class LogLine {
        +Severity: LogSeverity
        +Stamp: string
        +Text: string
        +DisplayText: string
        +{static} Donut(severity, text): LogLine
        +{static} FromWorkerLine(text, streamSeverity): LogLine
    }
}

AsyncJob --> RunspaceManager
AsyncJob --> WorkerProcess
PoolScriptJob ..> RunspaceManager : interactive pool
AsyncJob ..> JobStatus
AsyncJob ..> JobKind
AsyncJob ..> LogLine
LogLine ..> LogSeverity

@enduml

    }

    enum JobStatus {
        Created
        Running
        Completed
        Failed
    }

    enum JobKind {
        Scan
        UpdateScan
        UpdateApply
        Inventory
        DiskScan
        Resolve
    }

    enum FleetCardState {
        Queued
        Scanning
        Updating
        Completed
        RebootRequired
        Failed
    }

    class FleetCardStatus {
        +State: FleetCardState

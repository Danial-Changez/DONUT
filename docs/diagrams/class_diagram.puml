@startuml Class Diagram
title DONUT — Class Structure
skinparam classAttributeIconSize 0

' Each layer carries its own muted tint so the packages read at a glance:
'   Models = blue · Core = green · Services = violet · Presenters = amber
'   ViewModels = brown · Donut.Mvvm (C# bases) = olive
package "Donut.Models" #15233B {
    class AppConfig {

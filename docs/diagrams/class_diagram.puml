    }
    class RemoteConnectionLostException extends RemoteOperationException {
        +{static} IsConnectionLost(exitCode): bool
    }
    class RemoteTimeoutException extends RemoteOperationException {
        +TimeoutMinutes: int
    }
    class RemoteFailure {
        +{static} ReasonFromMessage(message): RemoteFailureReason
    }

    class ScanCacheDecision {
        +{static} IsFresh(lastJobType, lastSeen, now, ttl, reportExists): bool
    }

    class MachineInventory {
        +Model: string
        +ServiceTag: string
        +BiosVersion: string
